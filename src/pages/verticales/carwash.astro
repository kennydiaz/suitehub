---
import BaseLayout from '../../layouts/BaseLayout.astro';

const wa = (text: string) => `https://wa.me/50766326006?text=${encodeURIComponent(text)}`;
const waInfo = wa('Hola, quiero info de HUB Carwash 🚗');
const waDemo = wa('Hola, quiero una demo de HUB Carwash para mi car wash');

// Sin precios en esta página: la inversión se cotiza por proyecto (sistema base + integraciones + hardware).
const chips = [
  '🧾 Factura electrónica DGI',
  '🚦 5 pistas en vivo',
  '💸 Comisiones automáticas',
  '🎁 Fidelidad incluida',
];

// Recorrido: capturas reales de Hub Carwash (rediseño Minimal) en /public/images/products/carwash.
const shots = [
  {
    img: '/images/products/carwash/dashboard.webp', w: 1426, h: 718,
    title: 'Tu operación de hoy, de un vistazo',
    desc: 'Ventas del día y del mes, vehículos atendidos, ticket promedio y comisiones pendientes. Gráfica de ventas por día, mezcla por tipo de vehículo, servicios más vendidos y ranking de lavadores.',
    pts: ['Vehículos atendidos por rango de fechas', 'Servicios más vendidos y mezcla por tipo de vehículo', 'Ranking de lavadores por comisión'],
  },
  {
    img: '/images/products/carwash/nueva-orden.webp', w: 1426, h: 718,
    title: 'Recepción por placa en segundos',
    desc: 'Escribes la placa y el sistema trae al cliente, su vehículo y su historial. Eliges el tipo de vehículo, el lavado (sencillo, con cera o hidratación), los adicionales y la pista. El total, el ITBMS y la comisión se calculan solos.',
    pts: ['Cliente y vehículo precargados por placa', 'Precios por tipo de vehículo y adicionales editables', 'Asignación de pista y lavadores en la misma pantalla'],
  },
  {
    img: '/images/products/carwash/pistas.webp', w: 1426, h: 718,
    title: 'Cinco pistas en vivo',
    desc: 'Tablero de la cola: en espera, en proceso, terminado y entregado. Filtras por pista o por lavador. Cada lavador ve solo sus vehículos desde su celular y avanza el estado con un toque.',
    pts: ['Filtro por pista y por lavador', 'Vista de lavador en el celular, sin instalar nada', 'Contador de vehículos del día por estado'],
  },
  {
    img: '/images/products/carwash/pistas-movil.webp', w: 488, h: 718, phone: true,
    title: 'El lavador, desde su celular',
    desc: 'Cada lavador entra con su usuario y ve únicamente los vehículos que tiene asignados. Toca para pasar de "en proceso" a "terminado" y la caja se entera al instante. También consulta su comisión acumulada.',
    pts: ['Solo sus órdenes, nada más', 'Avanza el estado con un toque', 'Su comisión del período, siempre visible'],
  },
  {
    img: '/images/products/carwash/caja.webp', w: 1426, h: 718,
    title: 'Caja y cierre diario',
    desc: 'Cobros en efectivo, tarjeta o Yappy, pagos mixtos y ticket de 80 mm. Al cerrar el día, el sistema compara lo vendido con lo declarado y deja el arqueo registrado con la diferencia.',
    pts: ['Ticket térmico 80 mm con tu logo', 'Arqueo con efectivo declarado vs. sistema', 'Resumen gerencial por correo al cerrar caja'],
  },
  {
    img: '/images/products/carwash/factura.webp', w: 1426, h: 718,
    title: 'Factura electrónica ante la DGI',
    desc: 'Emites la factura electrónica desde la misma orden: CUFE, QR de verificación y formato carta o ticket. Consulta de RUC y DV en línea para clientes con empresa. Anulación desde el panel.',
    pts: ['CUFE y QR de verificación DGI', 'Consulta de RUC/DV para facturar a empresas', 'Estado por orden: emitida, pendiente, anulada'],
  },
  {
    img: '/images/products/carwash/cliente.webp', w: 1426, h: 718,
    title: 'Historial del cliente y de cada vehículo',
    desc: 'Ficha con teléfono, datos fiscales, vehículos registrados y todas las visitas: qué se le hizo, quién lo lavó, cuánto pagó. Varios vehículos por cliente, cada uno con su placa, marca, modelo y color.',
    pts: ['Varios vehículos por cliente', 'Historial completo de servicios y pagos', 'Datos fiscales guardados para facturar'],
  },
  {
    img: '/images/products/carwash/fidelidad.webp', w: 1426, h: 718,
    title: 'Fidelidad que trae clientes de vuelta',
    desc: 'Tarjeta de sellos digital: cada lavado suma y al llegar a la meta el siguiente es gratis. Tú defines la meta. Ves quién está cerca del premio y cuántos lavados gratis se han canjeado.',
    pts: ['Meta configurable (ej. 7 lavados, el 8.º gratis)', 'Clientes cerca del premio para avisarles', 'Canje directo desde la orden'],
  },
  {
    img: '/images/products/carwash/comisiones.webp', w: 1426, h: 718,
    title: 'Comisiones sin discusiones',
    desc: 'Cada orden reparte la comisión entre los lavadores asignados, con el porcentaje que definas. El lavador ve su acumulado desde su celular y tú liquidas por período con un clic.',
    pts: ['Porcentaje global o reparto por orden', 'Vista "Mi comisión" para cada lavador', 'Liquidación y registro de pagos'],
  },
];

const features = [
  { icon: 'fa-bolt',           name: 'Recepción por placa',       desc: 'Busca por placa o nombre; cliente, vehículo e historial precargados.' },
  { icon: 'fa-warehouse',      name: 'Gestión de pistas',         desc: 'Pistas configurables, cola en vivo por estado, filtro por pista y lavador.' },
  { icon: 'fa-spray-can-sparkles', name: 'POS de lavado',         desc: 'Tipos de vehículo, tres niveles de lavado, adicionales con precio editable, recargos.' },
  { icon: 'fa-cash-register',  name: 'Caja y arqueo',             desc: 'Efectivo, tarjeta, Yappy, pagos mixtos, ticket 80 mm, cierre con diferencia.' },
  { icon: 'fa-receipt',        name: 'Factura electrónica DGI',   desc: 'CUFE, QR, consulta RUC/DV, anulación, formato carta y ticket.' },
  { icon: 'fa-car-side',       name: 'Clientes y vehículos',      desc: 'Ficha completa, varios vehículos por cliente, datos fiscales.' },
  { icon: 'fa-medal',          name: 'Fidelidad',                 desc: 'Tarjeta de sellos digital con meta configurable y canje desde la orden.' },
  { icon: 'fa-percent',        name: 'Comisiones',                desc: 'Cálculo automático por lavador, vista personal y liquidación por período.' },
  { icon: 'fa-chart-line',     name: 'Reportes',                  desc: 'Dashboard gerencial con gráficas y resumen diario por correo.' },
];

// Fase 2: paquete de integraciones (se cotiza aparte, sobre el sistema base).
const integraciones = [
  { icon: 'fa-calendar-check', name: 'Citas online',              desc: 'Enlace público donde el cliente elige servicio, pista y hora. Solo ve horarios reales.' },
  { icon: 'fa-qrcode',         name: 'Puntos y QR por cliente',   desc: 'Cada cliente tiene su QR; al escanearlo en recepción aparece su ficha, puntos y membresía. Puntos por monto, canjeables en servicios.' },
  { icon: 'fa-id-card',        name: 'Membresías',                desc: 'Planes mensuales de N lavados o ilimitados, con vencimiento, cobro recurrente y control de uso en la orden.' },
  { icon: 'fa-comment-dots',   name: 'Notificaciones por WhatsApp', desc: '"Tu vehículo está listo", recordatorio de cita, puntos acumulados, promociones. API oficial de Meta.' },
  { icon: 'fa-boxes-stacked',  name: 'Inventario de insumos',     desc: 'Shampoo, cera, microfibras: stock, consumo por servicio, alertas de mínimo.' },
  { icon: 'fa-user-clock',     name: 'Control de empleados',      desc: 'Asistencia, turnos y horas por lavador, ligado a comisiones.' },
  { icon: 'fa-gauge-high',     name: 'Contador por pista',        desc: 'Vehículos en vivo por pista y tiempo promedio de servicio.' },
  { icon: 'fa-database',       name: 'Base de datos MySQL',       desc: 'Migración del motor para soportar citas públicas, webhooks y varias cajas simultáneas.' },
];

const benefits = [
  'Facturación electrónica DGI incluida',
  'Los lavadores lo usan desde su celular, sin instalar nada',
  'Tus datos en tu propia base, respaldados',
  'Soporte local por WhatsApp',
  'Todas las actualizaciones incluidas',
  'Instalación y capacitación por PROOQ en sitio',
];

const title = 'HUB Carwash — Sistema para car wash y autolavados en Panamá';
const description = 'Recepción por placa, pistas en vivo, caja, comisiones automáticas, fidelidad y factura electrónica DGI. El sistema para car wash hecho en Panamá.';
---
<BaseLayout title={title} description={description} ogImage="/images/products/carwash/dashboard.webp">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://suitehub.net/" },
      { "@type": "ListItem", "position": 2, "name": "Verticales", "item": "https://suitehub.net/verticales" },
      { "@type": "ListItem", "position": 3, "name": "HUB Carwash", "item": "https://suitehub.net/verticales/carwash" }
    ]
  })} />

  <!-- ░░ HERO ░░ -->
  <section class="relative overflow-hidden hero-carwash">
    <div class="absolute inset-x-0 top-0 h-[460px] bg-radial-brand pointer-events-none"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none"></div>
    <div class="wrap relative pt-10 pb-10 sm:pt-14 text-center">
      <a href="/verticales" class="inline-flex items-center gap-2 text-xs text-ink-400 hover:text-white transition-colors mb-8">
        <i class="fa-solid fa-arrow-left"></i> Todas las verticales
      </a>

      <div class="reveal max-w-3xl mx-auto">
        <img src="/images/products/carwash/badge.svg" alt="HUB Carwash" class="h-20 w-20 mx-auto mb-6" />
        <span class="eyebrow">Car wash y autolavados · Familia SuiteHub</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          El sistema para tu car wash, <span class="text-sky-400">de la recepción a la factura.</span>
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed max-w-2xl mx-auto">
          Registra el vehículo por placa, míralo avanzar por las pistas, cobra en caja, emite la factura
          electrónica ante la DGI y reparte comisiones sin hojas de cálculo. Todo en un solo panel, desde cualquier dispositivo.
        </p>

        <div class="mt-8 flex flex-wrap gap-3 justify-center">
          <a href={waDemo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Agendar demo por WhatsApp
          </a>
          <a href="#recorrido" class="btn-secondary">
            <i class="fa-solid fa-eye"></i> Ver el recorrido
          </a>
        </div>

        <div class="mt-9 flex flex-wrap gap-2.5 justify-center">
          {chips.map(c => (
            <span class="text-sm font-medium card-glass px-4 py-2.5">{c}</span>
          ))}
        </div>
      </div>

      <!-- Portada -->
      <div class="reveal show-glow max-w-4xl mx-auto mt-14">
        <figure class="browser">
          <div class="browser-bar">
            <span class="browser-dot bg-[#ff5f57]"></span>
            <span class="browser-dot bg-[#febc2e]"></span>
            <span class="browser-dot bg-[#28c840]"></span>
            <span class="browser-url">carwash.suitehub.net</span>
          </div>
          <img src="/images/products/carwash/dashboard.webp" alt="Dashboard de HUB Carwash" width="1426" height="718" decoding="async" class="w-full h-auto" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ░░ PROBLEMA → SOLUCIÓN ░░ -->
  <section class="pt-10 pb-4">
    <div class="wrap">
      <div class="reveal max-w-2xl mx-auto text-center">
        <p class="text-ink-400">😩 ¿Las órdenes en un talonario, las comisiones en Excel y la factura a mano al final del día?</p>
        <p class="text-2xl sm:text-3xl font-display font-bold my-4 leading-tight">
          De la placa a la factura, todo el car wash en <span class="text-sky-400">un solo panel</span>
        </p>
        <p class="text-ink-300">
          Recepción por placa, pistas en vivo, caja con arqueo, comisiones calculadas al cerrar cada orden
          y factura electrónica DGI desde la misma pantalla. Hecho en Panamá 🇵🇦
        </p>
      </div>
    </div>
  </section>

  <!-- ░░ RECORRIDO ░░ -->
  <section class="section" id="recorrido">
    <div class="wrap">
      <h2 class="text-center text-sm uppercase tracking-[0.2em] text-sky-400 font-semibold mb-16">
        Así se ve por dentro
      </h2>

      <div class="space-y-20 lg:space-y-28">
        {shots.map((s, i) => (
          <div class={`reveal grid gap-8 lg:gap-14 items-center ${s.phone ? 'lg:grid-cols-[1.3fr_.7fr]' : 'lg:grid-cols-2'}`}>
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <div class="flex items-center gap-3 text-sky-400 font-display font-bold text-sm tracking-widest mb-4">
                {String(i + 1).padStart(2, '0')}
                <span class="h-px w-12 bg-gradient-to-r from-sky-500 to-transparent"></span>
              </div>
              <h3 class="text-2xl lg:text-3xl font-display font-bold mb-3">{s.title}</h3>
              <p class="text-ink-300 leading-relaxed">{s.desc}</p>
              <ul class="mt-5 space-y-2">
                {s.pts.map(p => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-200">
                    <i class="fa-solid fa-check text-sky-400 mt-1"></i><span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class={`show-glow ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              {s.phone ? (
                <figure class="phone mx-auto">
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              ) : (
                <figure class="browser">
                  <div class="browser-bar">
                    <span class="browser-dot bg-[#ff5f57]"></span>
                    <span class="browser-dot bg-[#febc2e]"></span>
                    <span class="browser-dot bg-[#28c840]"></span>
                    <span class="browser-url">carwash.suitehub.net</span>
                  </div>
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ FUNCIONES ░░ -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="eyebrow">Todo lo que incluye</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">Funciones de HUB Carwash</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {features.map(f => (
          <div class="reveal card-glass p-6 hover:border-white/15 transition-colors">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-sky-400 bg-white/5 mb-4">
              <i class={`fa-solid ${f.icon} text-lg`}></i>
            </div>
            <div class="font-display font-semibold mb-1.5">{f.name}</div>
            <div class="text-sm text-ink-400 leading-relaxed">{f.desc}</div>
          </div>
        ))}
      </div>
      <p class="mt-7 text-xs text-ink-500 text-center">
        + Usuarios y roles (admin, cajero, lavador), catálogo de servicios, manual de uso en el sistema y licencia gestionada por SuiteHub.
      </p>
    </div>
  </section>

  <!-- ░░ INTEGRACIONES (FASE 2) ░░ -->
  <section class="section">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="eyebrow">Llévalo más lejos</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">Paquete de integraciones</h2>
        <p class="text-ink-400 mt-3">HUB Carwash crece con tu negocio. Estas integraciones se cotizan como paquete adicional sobre el sistema base, completo o por módulos.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integraciones.map(f => (
          <div class="reveal card-glass p-6 border-dashed hover:border-sky-500/40 transition-colors">
            <div class="flex items-center justify-between mb-4">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center text-sky-300 bg-sky-500/10">
                <i class={`fa-solid ${f.icon} text-lg`}></i>
              </div>
              <span class="text-[10px] uppercase tracking-wider text-sky-300/80 font-semibold border border-sky-500/30 rounded-full px-2 py-0.5">Adicional</span>
            </div>
            <div class="font-display font-semibold mb-1.5">{f.name}</div>
            <div class="text-sm text-ink-400 leading-relaxed">{f.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ LPR (FASE 3) ░░ -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="reveal">
          <span class="eyebrow">Cámaras LPR</span>
          <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">Reconocimiento de placas en la entrada</h2>
          <p class="text-ink-300 leading-relaxed">
            Con cámaras de reconocimiento de placas, el vehículo se registra solo: al llegar, HUB Carwash abre la
            orden con el cliente y su historial, y avisa por WhatsApp cuando está listo. PROOQ instala y configura las cámaras.
          </p>
          <ul class="mt-5 space-y-2">
            {['Cámaras Hikvision o Dahua con ANPR en el acceso', 'Puente local en tu red que envía cada placa al sistema', 'La orden se abre con cliente, vehículo e historial precargados', 'Aviso automático al cliente cuando el vehículo está listo'].map(p => (
              <li class="flex items-start gap-2.5 text-sm text-ink-200">
                <i class="fa-solid fa-check text-sky-400 mt-1"></i><span>{p}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-xs text-ink-500">Requiere red local e instalación en sitio. Se cotiza junto con el hardware.</p>
        </div>

        <div class="reveal card-glass p-6 lg:p-8">
          <svg viewBox="0 0 640 200" class="w-full h-auto" role="img" aria-label="Diagrama: cámara LPR, puente local, HUB Carwash en la nube, recepción y WhatsApp al cliente">
            <defs>
              <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0L10 5 0 10z" fill="#38BDF8"/>
              </marker>
            </defs>
            {[
              { x: 10,  t1: 'Cámara LPR',     t2: 'en la entrada',     icon: '📷' },
              { x: 175, t1: 'Puente local',   t2: 'mini PC en tu red', icon: '🖥️' },
              { x: 340, t1: 'HUB Carwash',    t2: 'en la nube',        icon: '☁️' },
              { x: 505, t1: 'Recepción',      t2: '+ WhatsApp',        icon: '💬' },
            ].map(n => (
              <g>
                <rect x={n.x} y="40" width="125" height="120" rx="16" fill="rgba(255,255,255,.04)" stroke="rgba(56,189,248,.35)"/>
                <text x={n.x + 62.5} y="86" text-anchor="middle" font-size="30">{n.icon}</text>
                <text x={n.x + 62.5} y="118" text-anchor="middle" font-size="13" font-weight="700" fill="#F8FAFC" font-family="Sora, Inter, sans-serif">{n.t1}</text>
                <text x={n.x + 62.5} y="138" text-anchor="middle" font-size="11" fill="#94A3B8" font-family="Inter, sans-serif">{n.t2}</text>
              </g>
            ))}
            <path d="M135 100 H173" stroke="#38BDF8" stroke-width="2" marker-end="url(#arr)"/>
            <path d="M300 100 H338" stroke="#38BDF8" stroke-width="2" marker-end="url(#arr)"/>
            <path d="M465 100 H503" stroke="#38BDF8" stroke-width="2" marker-end="url(#arr)"/>
            <text x="154" y="90" text-anchor="middle" font-size="9" fill="#64748B" font-family="Inter, sans-serif">placa</text>
            <text x="319" y="90" text-anchor="middle" font-size="9" fill="#64748B" font-family="Inter, sans-serif">HTTPS</text>
            <text x="484" y="90" text-anchor="middle" font-size="9" fill="#64748B" font-family="Inter, sans-serif">orden</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ HABLEMOS ░░ -->
  <section class="section">
    <div class="wrap">
      <div class="reveal card-glass gradient-border max-w-3xl mx-auto p-8 lg:p-12 text-center">
        <span class="eyebrow">Hablemos</span>
        <h2 class="text-2xl lg:text-3xl font-display font-bold mb-3">
          ¿Abres un car wash o quieres ordenar el que ya tienes?
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          Te mostramos HUB Carwash funcionando con tus servicios y tus pistas. Configuramos tu cuenta, cargamos tu
          catálogo y tus lavadores con sus comisiones, y capacitamos a tu equipo. Cotización por proyecto según las integraciones que necesites.
        </p>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-xl mx-auto text-left mb-8">
          {benefits.map(b => (
            <li class="flex items-start gap-2.5 text-sm text-ink-200">
              <i class="fa-solid fa-circle-check text-emerald-400 mt-0.5"></i>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href={waInfo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Escríbenos por WhatsApp
          </a>
          <a href="mailto:info@suitehub.net?subject=Quiero%20info%20de%20HUB%20Carwash" class="btn-secondary">
            <i class="fa-solid fa-envelope"></i> info@suitehub.net
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ CTA FINAL ░░ -->
  <section class="relative overflow-hidden border-t border-white/5">
    <div class="absolute inset-x-0 bottom-0 h-[300px] bg-radial-brand pointer-events-none rotate-180"></div>
    <div class="wrap relative py-20 text-center">
      <h2 class="reveal text-3xl lg:text-4xl font-display font-bold mb-4">
        ¿Listo para ver tus pistas <span class="text-sky-400">en vivo</span>?
      </h2>
      <p class="reveal text-ink-300 mb-8 max-w-xl mx-auto">
        Te hacemos una demo con tus servicios y tus pistas, sin compromiso.
      </p>
      <a href={waDemo} target="_blank" rel="noopener" class="reveal btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow text-base px-8 py-4">
