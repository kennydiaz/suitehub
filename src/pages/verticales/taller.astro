---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCatalog } from '../../lib/catalog';

const wa = (text: string) => `https://wa.me/50766326006?text=${encodeURIComponent(text)}`;
const waInfo = wa('Hola, quiero info de HUB Taller 🔧');
const waDemo = wa('Hola, quiero una demo de HUB Taller para mi taller');

// Precios vivos del catálogo (panel). Respaldo local si el panel no responde en build.
const cat = await getCatalog();
const vt = (cat.verticales || []).find((v: any) => v.key === 'taller');
const precioCore = vt?.planes?.core?.precio_mes ?? 48;
const precioPro  = vt?.planes?.pro?.precio_mes ?? 64;
const anualCore  = vt?.planes?.core?.precio_anio ?? precioCore * 10;
const anualPro   = vt?.planes?.pro?.precio_anio ?? precioPro * 10;

const chips = [
  '⚡ Recepción por placa',
  '📋 Órdenes de trabajo',
  '📲 Cotización aprobada por el cliente',
  '🧾 Factura electrónica DGI',
];

// Recorrido: cada pantalla con qué resuelve. Capturas en /public/images/products/taller.
const shots = [
  {
    img: '/images/products/taller/dashboard.webp', w: 1426, h: 718,
    title: 'Tu taller de un vistazo',
    desc: 'Al abrir el sistema ves cuántos carros hay en taller, cuáles están listos para entregar, las citas de hoy y lo facturado del mes. Nada de preguntar por el taller: está en pantalla.',
    pts: ['Vehículos en taller y órdenes por estado', 'Ingresos del mes y por cobrar', 'Citas de hoy y qué hay en cada bahía'],
  },
  {
    img: '/images/products/taller/recepcion.webp', w: 1426, h: 718,
    title: 'Recepción en dos pasos',
    desc: 'Escribes la placa y aparece la ficha del vehículo con su dueño y su último servicio. Registras kilometraje, combustible, motivo de ingreso, inventario de entrada y fotos, y sale el comprobante de 80 mm para el cliente.',
    pts: ['Si la placa no existe, creas cliente y vehículo sin salir de la pantalla', 'Comprobante impreso con los datos de entrada', 'La orden nace numerada (OT-0001) y con mecánico asignado'],
  },
  {
    img: '/images/products/taller/tablero.webp', w: 1426, h: 718,
    title: 'Tablero de órdenes por estado',
    desc: 'Cada columna es un estado del carro: recibido, diagnóstico, por aprobar, en proceso, listo. Asignas mecánico y ves cuánto tiempo lleva cada uno. Filtra por placa, cliente o mecánico.',
    pts: ['Tiempo en taller visible en cada tarjeta', 'Cotización enviada y aprobada marcadas', 'Lista o tablero, como prefieras trabajar'],
  },
  {
    img: '/images/products/taller/orden.webp', w: 1426, h: 718,
    title: 'La orden: ítems, aprobación y bitácora',
    desc: 'Servicios, repuestos y mano de obra con su precio, ITBMS y quién lo aprobó. La bitácora registra cada paso con hora. Desde aquí cotizas lo pendiente y facturas lo aprobado.',
    pts: ['Nunca se factura un ítem dos veces', 'Fotos de entrada y del diagnóstico adjuntas', 'WhatsApp al cliente con un toque'],
  },
  {
    img: '/images/products/taller/cotizacion-cliente.webp', w: 488, h: 718, phone: true,
    title: 'El cliente aprueba desde su teléfono',
    desc: 'Le mandas el enlace por WhatsApp y ve la cotización con el detalle: "¿Autoriza el trabajo por B/. 167.99?". Aprueba o rechaza con un toque, sin cuenta ni app, y la orden pasa sola a "en proceso".',
    pts: ['Enlace público con vencimiento, sin registro', 'Aprobar, rechazar o consultar por WhatsApp', 'Queda registrado quién aprobó y cuándo'],
  },
  {
    img: '/images/products/taller/factura.webp', w: 1426, h: 718,
    title: 'Factura electrónica desde la orden lista',
    desc: 'Cobras lo aprobado y sale la factura electrónica autorizada por la DGI con CUFE y QR, ticket de 80 mm o PDF carta, y el enlace para que el cliente la vea en su teléfono. Pagos parciales y crédito con vencimiento.',
    pts: ['CUFE, QR y correlativo fiscal en el documento', 'Ticket 80 mm, PDF y WhatsApp con un clic', 'Efectivo, tarjeta, Yappy, transferencia o crédito'],
  },
  {
    img: '/images/products/taller/vehiculo.webp', w: 1426, h: 718,
    title: 'Ficha e histórico de cada vehículo',
    desc: 'Visitas, kilometraje actual, gasto acumulado y última visita. El histórico completo de órdenes y los mantenimientos programados por kilometraje o fecha, con barra de avance y recordatorio al cliente.',
    pts: ['Próximo cambio de aceite, rotación, frenos, correa', 'Informe PDF del vehículo para el dueño', 'Programar recordatorio por WhatsApp'],
  },
  {
    img: '/images/products/taller/agenda.webp', w: 1426, h: 718,
    title: 'Agenda por mecánico y por bahía',
    desc: 'Vista de semana o de día con colores por mecánico. Clic en una hora libre y creas la cita por placa, aunque el cliente todavía no exista. Choques de bahía o de mecánico quedan bloqueados.',
    pts: ['Cita → "Llegó" → recepción con todo cargado', 'Recordatorios de mañana listos para WhatsApp', 'Estados: programada, confirmada, llegó, no vino'],
  },
  {
    img: '/images/products/taller/movil.webp', w: 488, h: 718, phone: true,
    title: 'El mecánico trabaja desde su celular',
    desc: 'Sus órdenes de hoy con el botón grande del siguiente paso: iniciar, marcar listo. Foto directa desde la cámara, nota rápida y agenda del día. Sin sidebar ni PC.',
    pts: ['Mis órdenes, esta semana y listas', 'Foto de evidencia en un toque', 'Su producción en el perfil'],
  },
];

const features = [
  { icon: 'fa-bolt',                 name: 'Recepción por placa',            desc: 'Placa → ficha. Kilometraje, combustible, motivo, inventario de entrada y fotos. Comprobante de 80 mm al instante.' },
  { icon: 'fa-clipboard-list',       name: 'Órdenes de trabajo',             desc: 'Servicios, repuestos y mano de obra en una orden numerada, con estados de recibido a entregado.' },
  { icon: 'fa-mobile-screen-button', name: 'Cotización aprobada por el cliente', desc: 'Se arma desde la orden; el cliente aprueba o rechaza desde un enlace en su teléfono, sin cuenta ni app.' },
  { icon: 'fa-receipt',              name: 'Factura electrónica DGI',        desc: 'Cobras desde la orden lista: CUFE y QR con tu PAC, ticket 80 mm o PDF carta, pagos parciales y crédito.' },
  { icon: 'fa-calendar-days',        name: 'Agenda que se convierte en orden', desc: 'Citas por placa, mecánico y bahía. "Llegó" abre la recepción con todo cargado.' },
  { icon: 'fa-mobile-screen',        name: 'El mecánico en su celular',      desc: 'Sus órdenes del día, el botón del siguiente paso, foto desde la cámara y nota rápida.' },
  { icon: 'fa-car',                  name: 'Histórico por vehículo',         desc: 'Visitas, kilometraje, gasto acumulado y mantenimientos programados por km o fecha.' },
  { icon: 'fa-cash-register',        name: 'Caja y cuentas por cobrar',      desc: 'Turnos con arqueo, quién debe y desde cuándo, recordatorio de cobro por WhatsApp.' },
  { icon: 'fa-chart-column',         name: 'Reportes descargables',          desc: 'Taller, dinero, mecánicos, inventario y clientes, por período y a Excel.' },
];

const benefits = [
  'Facturación electrónica DGI incluida',
  'Funciona en la PC del mostrador y en el celular del mecánico',
  'Datos del taller en tu propia base, respaldados',
  'Soporte local por WhatsApp',
  'Todas las actualizaciones incluidas',
  'Sin contratos eternos',
];

const title = 'HUB Taller — Sistema para talleres mecánicos en Panamá';
const description = 'Recepción por placa, órdenes de trabajo, cotización que el cliente aprueba desde su teléfono, agenda por mecánico y bahía, factura electrónica DGI y el mecánico trabajando desde su celular. Desde $' + precioCore + '/mes.';
---
<BaseLayout title={title} description={description} ogImage="/images/products/taller/dashboard.webp">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://suitehub.net/" },
      { "@type": "ListItem", "position": 2, "name": "Verticales", "item": "https://suitehub.net/verticales" },
      { "@type": "ListItem", "position": 3, "name": "HUB Taller", "item": "https://suitehub.net/verticales/taller" }
    ]
  })} />

  <!-- ░░ HERO ░░ -->
  <section class="relative overflow-hidden hero-taller">
    <div class="absolute inset-x-0 top-0 h-[460px] bg-radial-brand pointer-events-none"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none"></div>
    <div class="wrap relative pt-10 pb-10 sm:pt-14 text-center">
      <a href="/verticales" class="inline-flex items-center gap-2 text-xs text-ink-400 hover:text-white transition-colors mb-8">
        <i class="fa-solid fa-arrow-left"></i> Todas las verticales
      </a>

      <div class="reveal max-w-3xl mx-auto">
        <img src="/images/products/taller/badge.svg" alt="HUB Taller" class="h-20 w-20 mx-auto mb-6" />
        <span class="eyebrow">Talleres mecánicos · Familia SuiteHub</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          HUB <span class="text-amber-400">Taller</span>
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed max-w-2xl mx-auto">
          Del ingreso a la factura, cada carro en una sola orden. Recepción por placa, cotización que el
          cliente aprueba desde su teléfono, agenda por bahía y el mecánico trabajando desde su celular.
        </p>

        <div class="mt-8 flex flex-wrap gap-3 justify-center">
          <a href={waInfo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Pregunta por HUB Taller
          </a>
          <a href={waDemo} target="_blank" rel="noopener" class="btn-secondary">
            <i class="fa-solid fa-play"></i> Agenda una demo
          </a>
        </div>

        <div class="mt-9 flex flex-wrap gap-2.5 justify-center">
          {chips.map(c => (
            <span class="text-sm font-medium card-glass px-4 py-2.5">{c}</span>
          ))}
        </div>
      </div>

      <!-- Portada -->
      <div class="reveal show-glow max-w-4xl mx-auto mt-14">
        <figure class="browser">
          <div class="browser-bar">
            <span class="browser-dot bg-[#ff5f57]"></span>
            <span class="browser-dot bg-[#febc2e]"></span>
            <span class="browser-dot bg-[#28c840]"></span>
            <span class="browser-url">suitehub.net/taller</span>
          </div>
          <img src="/images/products/taller/dashboard.webp" alt="Dashboard de HUB Taller" width="1426" height="718" decoding="async" class="w-full h-auto" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ░░ PROBLEMA → SOLUCIÓN ░░ -->
  <section class="pt-10 pb-4">
    <div class="wrap">
      <div class="reveal max-w-2xl mx-auto text-center">
        <p class="text-ink-400">😩 ¿Recibes carros en un cuaderno, cotizas por WhatsApp y al final nadie sabe qué se aprobó?</p>
        <p class="text-2xl sm:text-3xl font-display font-bold my-4 leading-tight">
          Del ingreso a la factura, cada carro en <span class="text-amber-400">una sola orden</span>
        </p>
        <p class="text-ink-300">
          Recepción por placa con comprobante, tablero de órdenes por estado, cotización que el cliente
          aprueba desde su teléfono, factura electrónica al cobrar y el mecánico desde su celular. Hecho en Panamá 🇵🇦
        </p>
      </div>
    </div>
  </section>

  <!-- ░░ RECORRIDO ░░ -->
  <section class="section">
    <div class="wrap">
      <h2 class="text-center text-sm uppercase tracking-[0.2em] text-amber-400 font-semibold mb-16">
        Así se ve por dentro
      </h2>

      <div class="space-y-20 lg:space-y-28">
        {shots.map((s, i) => (
          <div class={`reveal grid gap-8 lg:gap-14 items-center ${s.phone ? 'lg:grid-cols-[1.3fr_.7fr]' : 'lg:grid-cols-2'}`}>
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <div class="flex items-center gap-3 text-amber-400 font-display font-bold text-sm tracking-widest mb-4">
                {String(i + 1).padStart(2, '0')}
                <span class="h-px w-12 bg-gradient-to-r from-amber-500 to-transparent"></span>
              </div>
              <h3 class="text-2xl lg:text-3xl font-display font-bold mb-3">{s.title}</h3>
              <p class="text-ink-300 leading-relaxed">{s.desc}</p>
              <ul class="mt-5 space-y-2">
                {s.pts.map(p => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-200">
                    <i class="fa-solid fa-check text-amber-400 mt-1"></i><span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class={`show-glow ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              {s.phone ? (
                <figure class="phone mx-auto">
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              ) : (
                <figure class="browser">
                  <div class="browser-bar">
                    <span class="browser-dot bg-[#ff5f57]"></span>
                    <span class="browser-dot bg-[#febc2e]"></span>
                    <span class="browser-dot bg-[#28c840]"></span>
                    <span class="browser-url">suitehub.net/taller</span>
                  </div>
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ FUNCIONES ░░ -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="eyebrow">Todo lo que incluye</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">Funciones de HUB Taller</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {features.map(f => (
          <div class="reveal card-glass p-6 hover:border-white/15 transition-colors">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-amber-400 bg-white/5 mb-4">
              <i class={`fa-solid ${f.icon} text-lg`}></i>
            </div>
            <div class="font-display font-semibold mb-1.5">{f.name}</div>
            <div class="text-sm text-ink-400 leading-relaxed">{f.desc}</div>
          </div>
        ))}
      </div>
      <p class="mt-7 text-xs text-ink-500 text-center">
        + Todas las funciones del núcleo SuiteHub: clientes, servicios, repuestos, cotizaciones, facturas, caja y cuentas por cobrar.
      </p>
    </div>
  </section>

  <!-- ░░ PRECIOS ░░ -->
  <section class="section">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="eyebrow">Precios transparentes</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">Dos formas de tenerlo</h2>
        <p class="text-ink-400 mt-3">Pagas mes a mes. Si pagas el año, son 10 meses. ¿Varias sucursales? Enterprise las consolida.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
        <div class="reveal card-glass p-7">
          <div class="text-xs uppercase tracking-wider text-ink-400 font-semibold">HUB Taller</div>
          <div class="mt-2"><span class="text-4xl font-display font-bold">${precioCore}</span><span class="text-sm text-ink-400">/mes</span></div>
          <div class="text-xs text-ink-500 mt-1">o ${anualCore} al año</div>
          <p class="text-sm text-ink-300 mt-4">Todo lo de esta página, para una sucursal. Factura electrónica DGI incluida.</p>
        </div>
        <div class="reveal card-glass p-7 border-amber-500/40 shadow-glow-sm">
          <div class="text-xs uppercase tracking-wider text-amber-400 font-semibold">HUB Taller Pro</div>
          <div class="mt-2"><span class="text-4xl font-display font-bold">${precioPro}</span><span class="text-sm text-ink-400">/mes</span></div>
          <div class="text-xs text-ink-500 mt-1">o ${anualPro} al año</div>
          <p class="text-sm text-ink-300 mt-4">Lo mismo, personalizable: tu marca en facturas y correos, automatizaciones, API y webhooks.</p>
        </div>
      </div>
      <p class="mt-6 text-xs text-ink-500 text-center">
        El PAC de facturación electrónica lo contratas tú directo; nosotros ya estamos conectados a los autorizados por la DGI. <a href="/precios" class="text-brand-400 hover:text-brand-300">Ver comparativa completa</a>.
      </p>
    </div>
  </section>

  <!-- ░░ HABLEMOS ░░ -->
  <section class="section pt-0">
    <div class="wrap">
      <div class="reveal card-glass gradient-border max-w-3xl mx-auto p-8 lg:p-12 text-center">
        <span class="eyebrow">Hablemos</span>
        <h2 class="text-2xl lg:text-3xl font-display font-bold mb-3">
          Te lo montamos con tus servicios, tus mecánicos y tus bahías.
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          Configuramos tu cuenta, cargamos tu catálogo de servicios y repuestos y capacitamos a tu equipo.
          Ves HUB Taller con tus datos antes de decidir.
        </p>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-xl mx-auto text-left mb-8">
          {benefits.map(b => (
            <li class="flex items-start gap-2.5 text-sm text-ink-200">
              <i class="fa-solid fa-circle-check text-emerald-400 mt-0.5"></i>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href={waInfo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Escríbenos por WhatsApp
          </a>
          <a href="mailto:info@suitehub.net?subject=Quiero%20info%20de%20HUB%20Taller" class="btn-secondary">
            <i class="fa-solid fa-envelope"></i> info@suitehub.net
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ CTA FINAL ░░ -->
  <section class="relative overflow-hidden border-t border-white/5">
    <div class="absolute inset-x-0 bottom-0 h-[300px] bg-radial-brand pointer-events-none rotate-180"></div>
    <div class="wrap relative py-20 text-center">
      <h2 class="reveal text-3xl lg:text-4xl font-display font-bold mb-4">
        ¿Listo para <span class="text-amber-400">recibir el próximo carro</span> sin cuaderno?
      </h2>
      <p class="reveal text-ink-300 mb-8 max-w-xl mx-auto">
        Te hacemos una demo con tus propios servicios, sin compromiso.
      </p>
      <a href={waDemo} target="_blank" rel="noopener" class="reveal btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow text-base px-8 py-4">
        <i class="fa-brands fa-whatsapp text-xl"></i> Agenda tu demo
      </a>
    </div>
  </section>

  <style>
    .hero-taller { background-image: linear-gradient(180deg, rgba(7,10,18,.55), #06192E 92%), url('/images/products/taller/hero.webp'); background-size: cover; background-position: center 30%; }
    .browser { border: 1px solid rgba(255,255,255,.1); border-radius: 14px; overflow: hidden; background: #0B0F1A; box-shadow: 0 38px 84px -30px rgba(0,0,0,.85); }
    .browser-bar { display: flex; align-items: center; gap: 7px; padding: 10px 13px; background: #06192E; border-bottom: 1px solid rgba(255,255,255,.08); }
    .browser-dot { width: 11px; height: 11px; border-radius: 50%; flex: none; }
    .browser-url { margin-left: 10px; font-size: 11px; color: #647088; background: #020617; border: 1px solid rgba(255,255,255,.08); border-radius: 6px; padding: 5px 12px; font-family: ui-monospace, monospace; }
    .phone { width: min(300px, 80%); border-radius: 34px; border: 8px solid #141a26; background: #000; overflow: hidden; box-shadow: 0 38px 84px -30px rgba(0,0,0,.85); }
    .show-glow { position: relative; }
    .show-glow::before { content: ''; position: absolute; inset: -2px; z-index: -1; border-radius: 16px; background: radial-gradient(60% 80% at 50% 0%, rgba(245,158,11,.30), transparent 70%); filter: blur(22px); }
    @media (max-width: 640px) { .browser-url { display: none; } }
  </style>

</BaseLayout>
