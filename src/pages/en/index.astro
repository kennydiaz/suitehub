---
import BaseLayout from '../../layouts/BaseLayout.astro';

const verticals = [
  { key: 'taller',     name: 'HUB Workshop',    desc: 'Auto repair shops',         icon: 'fa-screwdriver-wrench' },
  { key: 'carwash',    name: 'HUB Carwash',     desc: 'Car washes and detailing',  icon: 'fa-spray-can-sparkles' },
  { key: 'pos',        name: 'HUB POS',         desc: 'Restaurants, bars and food trucks', icon: 'fa-cash-register' },
  { key: 'restaurant', name: 'HUB Restaurant',  desc: 'Sit-down restaurants',      icon: 'fa-utensils' },
  { key: 'market',     name: 'HUB Market',       desc: 'Minimarkets and groceries', icon: 'fa-cart-shopping' },
  { key: 'boutique',   name: 'HUB Boutique',     desc: 'Clothing boutiques and retail', icon: 'fa-shirt' },
  { key: 'pet',        name: 'HUB Pet',         desc: 'Vets and pet shops',        icon: 'fa-paw' },
  { key: 'lavanderia', name: 'HUB Laundry',     desc: 'Professional laundries',    icon: 'fa-soap' },
  { key: 'salon',      name: 'HUB Salon',       desc: 'Beauty salons, barbershops', icon: 'fa-scissors' },
  { key: 'clinic',     name: 'HUB Clinic',      desc: 'Medical practices and clinics', icon: 'fa-stethoscope' },
  { key: 'gym',        name: 'HUB Gym',         desc: 'Gyms and CrossFit boxes',   icon: 'fa-dumbbell' },
  { key: 'inmobiliaria', name: 'HUB Real Estate', desc: 'Real estate agencies',    icon: 'fa-building' },
  { key: 'hotel',      name: 'HUB Hotel',       desc: 'Boutique hotels',           icon: 'fa-hotel' },
  { key: 'phone',      name: 'HUB Phone',       desc: 'Phone repair shops',        icon: 'fa-mobile-screen' },
  { key: 'traffic',    name: 'HUB Traffic',     desc: 'In-store foot traffic and heatmaps', icon: 'fa-people-arrows' },
];

const pacs = [
  {
    name: 'Digifact',
    desc: 'DGI-certified PAC with a modern API',
    icon: 'fa-bolt',
    color: 'text-brand-400',
  },
  {
    name: 'The Factory HKA',
    desc: 'Regional leader in electronic invoicing',
    icon: 'fa-industry',
    color: 'text-sky-400',
  },
  {
    name: 'Ebi PAC',
    desc: 'SOAP issuance with CUFE, QR and DGI protocol',
    icon: 'fa-network-wired',
    color: 'text-violet-400',
  },
  {
    name: 'Factura Fácil',
    desc: 'Panamanian PAC that keeps things simple',
    icon: 'fa-receipt',
    color: 'text-emerald-400',
  },
  {
    name: 'eFacturapty',
    desc: 'DGI-certified Panamanian PAC',
    icon: 'fa-file-invoice',
    color: 'text-amber-400',
  },
  {
    name: 'The Factory HKA Venezuela',
    desc: 'SENIAT Imprenta Digital for Venezuela',
    icon: 'fa-globe-americas',
    color: 'text-fuchsia-400',
  },
];

const testimonials = [
  {
    quote: 'We switched from a legacy system to the Hub Pro and within a week we were issuing electronic invoices with zero DGI rejections. The difference is huge.',
    author: 'Raúl Romero',
    role:   'Lead Technician · QS Express',
    initial: 'R',
    logo:    '/images/tallerqsexpress.png',
  },
];

const clients = [
  { name: 'QS Express',          sector: 'Auto repair shop',        logo: '/images/tallerqsexpress.png' },
  { name: 'Clean Factory',       sector: 'Shoe cleaning',           logo: '/images/cleanfactory.webp' },
  { name: 'KM Seguridad',        sector: 'Security',                logo: '/images/kmslogo.webp' },
  { name: 'CVE Panamá',          sector: 'Technology distribution', logo: '/images/cvepanama_web.webp' },
  { name: 'Inversiones Fortune', sector: 'International consulting', logo: '/images/fortune.webp' },
];

const stats = [
  { num: '+50',  label: 'Active SMBs (Panama)' },
  { num: '5',    label: 'Target countries (PA · US · VE · ES · CO)' },
  { num: '15',   label: 'Specialized verticals' },
  { num: '<24h', label: 'Support response time' },
];

---
<BaseLayout
  title="SuiteHub: business management and e-invoicing for SMBs"
  description="Business management software for small businesses, made by PROOQ LLC (USA). Electronic invoicing is live with DGI in Panama and SENIAT in Venezuela, with Facturae (Spain), DIAN (Colombia) and US state-level compliance planned for 2026. Multi-branch, automations and API. Available in English and Spanish, from $24/month.">

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-[600px] bg-radial-brand pointer-events-none" aria-hidden="true"></div>

    <div class="wrap relative section">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="animate-fade-up">
          <span class="eyebrow">
            <i class="fa-solid fa-bolt mr-1"></i> Software for SMBs · PA · US · VE · ES · CO
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05] tracking-tight">
            The system<br/>
            <span class="text-gradient">that grows</span><br/>
            with your business.
          </h1>
          <p class="mt-6 text-lg text-ink-300 max-w-xl leading-relaxed">
            Business management software for small businesses in <strong class="text-white">Panama, USA, Venezuela, Spain, and Colombia</strong>.
            E-invoicing for your country, multiple branches, automated tasks, and a REST API.
            <span class="text-brand-300">From $24/month.</span>
          </p>

          <div class="mt-5 inline-flex items-center gap-2 text-xs px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-300">
            <i class="fa-solid fa-globe"></i>
            Available in <strong class="text-white">English</strong> and <strong class="text-white">Spanish</strong>
          </div>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="https://wa.me/50766326006?text=Hello%2C%20I%27d%20like%20a%20demo"
               target="_blank" rel="noopener" class="btn-primary text-base">
              <i class="fa-brands fa-whatsapp text-xl"></i>
              Talk to our team
            </a>
            <a href="/en/pricing" class="btn-secondary text-base">
              See editions and pricing
              <i class="fa-solid fa-arrow-right text-xs ml-1"></i>
            </a>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-6 text-sm text-ink-400">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-shield-halved text-emerald-400"></i>
              Electronic invoicing
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-clock text-brand-400"></i>
              Ready in 24 hours
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-headset text-brand-400"></i>
              EN / ES support
            </div>
          </div>
        </div>

        <!-- Visual: illustration of the SuiteHub office -->
        <div class="relative animate-fade-in" style="perspective:1200px;">
          <!-- Glow orb -->
          <div class="absolute -inset-10 bg-brand-600/20 rounded-full blur-3xl" aria-hidden="true"></div>

          <div id="hero-tilt" class="tilt relative browser-mock">
            <img src="/images/suitehub-hero.webp" alt="Illustration of the SuiteHub office with the team at work"
                 width="1200" height="896" fetchpriority="high"
                 class="w-full block" />
          </div>

          <!-- Floating pill: e-invoicing -->
          <div class="absolute -top-4 -right-2 sm:-right-5 card-glass px-3.5 py-2 flex items-center gap-2 shadow-2xl">
            <i class="fa-solid fa-receipt text-emerald-400"></i>
            <span class="text-xs font-medium">Electronic invoice with CUFE</span>
          </div>

          <!-- Floating pill: live -->
          <div class="absolute -bottom-5 left-3 sm:-left-5 card-glass px-4 py-2.5 flex items-center gap-3 shadow-2xl">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-medium">+50 businesses invoicing today</span>
          </div>
        </div>
      </div>

      <div class="reveal mt-20 lg:mt-28 grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/5 rounded-2xl overflow-hidden border border-white/5">
        {stats.map((s, i) => (
          <div class={`reveal reveal-delay-${i + 1} bg-navy-950 p-6 lg:p-8 text-center`}>
            <div class="text-3xl lg:text-4xl font-display font-bold text-white tabular-nums" data-countup={s.num}>{s.num}</div>
            <div class="text-xs uppercase tracking-wider text-ink-400 mt-2">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ONE PLATFORM, MANY BUSINESSES -->
  <section class="section">
    <div class="wrap">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="eyebrow">One platform</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold">
          Your business and the one next door, <span class="text-gradient">on the same system.</span>
        </h2>
        <p class="mt-5 text-ink-300 leading-relaxed">
          A restaurant, a repair shop, a salon, a store, a clinic and a hotel all work differently,
          and each one runs its own version of SuiteHub. Underneath, it is the same engine: sales,
          inventory, electronic invoicing and reports in one place.
        </p>
      </div>

      <figure class="reveal max-w-5xl mx-auto">
        <img src="/images/suitehub-ecosistema.webp"
             alt="Illustration of a block of businesses (restaurant, store, repair shop, salon, clinic, gym and hotel) connected to the SuiteHub system"
             width="1200" height="670" loading="lazy" decoding="async"
             class="w-full block rounded-2xl border border-white/10 shadow-2xl" />
      </figure>

      <p class="text-center mt-8 text-sm text-ink-400">
        There is a version for every trade.
        <a href="/en/verticals" class="text-brand-400 hover:text-brand-300 font-medium">See the verticals</a>.
      </p>
    </div>
  </section>

  <!-- PACs -->
  <section class="py-16 sm:py-20 bg-navy-900/30 border-y border-white/5">
    <div class="wrap">
      <div class="text-center mb-10">
        <span class="eyebrow">Electronic invoicing by country</span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold">
          We already work with <span class="text-gradient">6 PACs</span>, 5 with Panama's DGI and 1 with Venezuela's SENIAT · Coming next: Facturae ES, DIAN CO, US compliance
        </h2>
        <p class="mt-3 text-sm text-ink-400 max-w-xl mx-auto">
          You pick the PAC. SuiteHub connects directly and takes care of the whole process (XML, CUFE and QR in Panama; JSON and Control Number in Venezuela), so you don't have to keep up with the rules yourself. It's also built to add new countries without changing the way you work.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {pacs.map((p, i) => (
          <div class={`reveal reveal-delay-${i + 1} lift card-glass p-6 text-center hover:border-brand-500/30 transition-colors`}>
            <div class={`w-12 h-12 mx-auto rounded-xl bg-white/5 flex items-center justify-center text-2xl mb-3 ${p.color}`}>
              <i class={`fa-solid ${p.icon}`}></i>
            </div>
            <div class="font-display font-semibold text-base">{p.name}</div>
            <p class="text-xs text-ink-400 mt-1.5">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VERTICALS -->
  <section id="verticals" class="section bg-navy-900/50 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-600/10 rounded-full blur-3xl"></div>

    <div class="wrap relative">
      <div class="text-center mb-16 max-w-2xl mx-auto">
        <span class="eyebrow">Specialized verticals</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold">
          A version <span class="text-gradient">for every business.</span>
        </h2>
        <p class="mt-5 text-ink-300 leading-relaxed">
          A repair shop doesn't run like a restaurant or a clinic.
          Each vertical is SuiteHub adjusted to one type of business, with its own terms and steps, and you can start using it on day one.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {verticals.map((v, i) => (
          <a href={`/en/verticals#${v.key}`}
             class={`reveal reveal-delay-${(i % 4) + 1} group lift card-glass p-5 hover:border-brand-500/30 hover:bg-white/[0.05] transition-all`}>
            <img src={`/images/products/${v.key}/badge.svg`} alt={v.name} class="w-12 h-12 mb-4 group-hover:scale-110 transition-transform" loading="lazy" />
            <h3 class="text-base font-display font-semibold mb-1">{v.name}</h3>
            <p class="text-xs text-ink-400">{v.desc}</p>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/en/verticals" class="inline-flex items-center gap-2 text-brand-400 hover:text-brand-300 text-sm font-medium">
          Explore all verticals <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="eyebrow">Who already uses it</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold">
          Businesses already <span class="text-gradient">running on SuiteHub.</span>
        </h2>
        <p class="mt-5 text-ink-300 leading-relaxed">
          A repair shop, a shoe cleaning service, a security company, a distributor and a consultancy.
          Different trades, the same system underneath.
        </p>
      </div>

      <ul class="flex flex-wrap justify-center gap-5 sm:gap-6">
        {clients.map((c, i) => (
          <li class={`reveal reveal-delay-${(i % 4) + 1} text-center`}>
            <div class="w-32 h-20 sm:w-36 sm:h-24 rounded-2xl bg-white p-3.5 flex items-center justify-center">
              <img src={c.logo} alt={c.name} width="144" height="96" loading="lazy" class="max-h-full max-w-full object-contain" />
            </div>
            <div class="mt-2.5 text-xs font-medium text-ink-200">{c.name}</div>
            <div class="text-[11px] text-ink-500">{c.sector}</div>
          </li>
        ))}
      </ul>

      <div class="max-w-2xl mx-auto mt-14">
        {testimonials.map((t, i) => (
          <figure class={`reveal reveal-delay-${i + 1} card-glass p-7 flex flex-col`}>
            <div class="text-brand-400 text-2xl mb-4">
              <i class="fa-solid fa-quote-left"></i>
            </div>
            <blockquote class="text-ink-200 leading-relaxed flex-1 italic">
              "{t.quote}"
            </blockquote>
            <figcaption class="mt-6 pt-6 border-t border-white/5 flex items-center gap-3">
              {t.logo ? (
                <img src={t.logo} alt={t.author} class="w-10 h-10 rounded-full bg-white/10 object-contain p-1" />
              ) : (
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-bold text-sm">
                  {t.initial}
                </div>
              )}
              <div>
                <div class="text-sm font-medium text-white">{t.author}</div>
                <div class="text-xs text-ink-400">{t.role}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/en/cases" class="inline-flex items-center gap-2 text-brand-400 hover:text-brand-300 text-sm font-medium">
          Read the full case studies <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-brand pointer-events-none"></div>

    <div class="wrap relative">
      <div class="card-glass gradient-border text-center p-12 lg:p-16 max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold mb-5">
          We'll help you <span class="text-gradient">get started today.</span>
        </h2>
        <p class="text-ink-300 max-w-xl mx-auto leading-relaxed mb-10">
          Send us a message on WhatsApp and we'll show you SuiteHub live in under 15 minutes.
          You don't have to fill out any forms or commit to anything.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://wa.me/50766326006?text=Hello%2C%20I%27d%20like%20to%20book%20a%20demo"
             target="_blank" rel="noopener"
             class="btn-primary text-base px-8">
            <i class="fa-brands fa-whatsapp text-xl"></i>
            Chat on WhatsApp
          </a>
          <a href="mailto:info@suitehub.net?subject=I%27d%20like%20to%20learn%20about%20SuiteHub"
             class="btn-secondary text-base px-8">
            <i class="fa-solid fa-envelope"></i>
            Send an email
          </a>
        </div>
        <p class="mt-8 text-xs text-ink-500">
          Or call us at <a href="tel:+50766326006" class="text-ink-300 hover:text-white">+507 6632-6006</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Micro-interactions: count-up · hero tilt -->
  <script is:inline>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Count-up on stats */
      const counters = document.querySelectorAll('[data-countup]');
      if (counters.length && !reduce && 'IntersectionObserver' in window) {
        counters.forEach((el) => {
          const m = (el.dataset.countup || '').match(/^(\D*)(\d+)(.*)$/);
          if (m) el.textContent = m[1] + '0' + m[3];
        });
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            obs.unobserve(e.target);
            const el = e.target;
            const raw = el.dataset.countup;
            const m = raw.match(/^(\D*)(\d+)(.*)$/);
            if (!m) { el.textContent = raw; return; }
            const pre = m[1], target = parseInt(m[2], 10), suf = m[3];
            const dur = 1100, t0 = performance.now();
            (function tick(now) {
              const p = Math.min((now - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = pre + Math.round(target * eased) + suf;
              if (p < 1) requestAnimationFrame(tick); else el.textContent = raw;
            })(t0);
          });
        }, { threshold: 0.4 });
        counters.forEach((el) => obs.observe(el));
      }

      /* Hero 3D tilt (fine pointer only, no reduced-motion) */
      const tilt = document.getElementById('hero-tilt');
      if (tilt && !reduce && window.matchMedia('(pointer: fine)').matches) {
        const max = 6;
        tilt.addEventListener('mousemove', (ev) => {
          const r = tilt.getBoundingClientRect();
          const px = (ev.clientX - r.left) / r.width - 0.5;
          const py = (ev.clientY - r.top) / r.height - 0.5;
          tilt.style.transform = 'rotateY(' + (px * max) + 'deg) rotateX(' + (-py * max) + 'deg)';
        });
        tilt.addEventListener('mouseleave', () => { tilt.style.transform = ''; });
      }
    })();
  </script>

</BaseLayout>
