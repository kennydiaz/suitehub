---
import BaseLayout from '../../layouts/BaseLayout.astro';

const values = [
  {
    icon: 'fa-bullseye',
    title: 'Pragmatic',
    desc: 'We don\'t sell technology because it\'s trendy. If a feature is in SuiteHub, it\'s there because it fixed a specific problem for an actual customer.',
  },
  {
    icon: 'fa-handshake',
    title: 'Approachable',
    desc: 'Send us a WhatsApp message and we\'ll get back to you. There are no tickets or support tiers, because a small business doesn\'t need corporate red tape.',
  },
  {
    icon: 'fa-shield-halved',
    title: 'Rigorous',
    desc: 'Our electronic invoicing is certified, our code runs through automated tests, and we back up every day. Your business depends on this working.',
  },
  {
    icon: 'fa-rocket',
    title: 'Fast',
    desc: 'We get you set up in 24 hours and ship small changes the same day. A small business can\'t sit through 6 months of implementation.',
  },
];

const milestones = [
  {
    year: '2020',
    title: 'SuiteHub is born',
    desc:  'We started SuiteHub in Panama with a simple idea: build management software for Spanish-speaking small businesses from the ground up, instead of translating something made for another market.',
  },
  {
    year: '2026 Q1',
    title: 'First DGI Panama electronic invoice',
    desc:  'QS Express issues the first electronic invoice with SuiteHub. It has had zero rejections in production since that day.',
  },
  {
    year: '2026 Q2',
    title: 'Launch of the HUB family',
    desc:  'Four editions (Hub Lite, Hub Core, Hub Pro, and Hub Enterprise) and 15 specialized verticals.',
  },
  {
    year: '2026 Q2',
    title: 'First SENIAT Venezuela issuance',
    desc:  'We validated the integration with The Factory HKA Venezuela (Imprenta Digital) end to end. Venezuela becomes the first country outside Panama with live electronic invoicing.',
  },
  {
    year: '2026',
    title: 'Expanding to more countries',
    desc:  'SuiteHub becomes a PROOQ LLC (USA) product, with local operations in Panama through PROOQ S.A. We open in Spain and get started in Venezuela and Colombia.',
  },
  {
    year: 'Today',
    title: '+50 active SMBs in Panama',
    desc:  'Repair shops, restaurants, retail stores, clinics, vet practices, and more are invoicing with SuiteHub across Panama. We also serve clients in the USA and Spain, and we\'re just getting started in Venezuela and Colombia.',
  },
  {
    year: 'Roadmap',
    title: 'Electronic invoicing in more countries',
    desc:  'We\'re building e-invoicing beyond Panama with authorized technology providers. That means DIAN in Colombia (CUFE and the POS equivalent document), Facturae in Spain, and US compliance. It\'s planned for 2026 and 2027. SENIAT Venezuela is already live.',
  },
];
---
<BaseLayout title="About us · SuiteHub" description="SuiteHub is business management software for SMBs in Panama, the USA, Venezuela, Spain, and Colombia, adapted to each country's rules. A PROOQ LLC (USA) product.">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[400px] bg-radial-brand pointer-events-none"></div>
    <div class="wrap relative pt-12 pb-20">
      <div class="text-center max-w-3xl mx-auto">
        <span class="eyebrow">About us</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          Business software <span class="text-gradient">from Panama</span><br/>
          for SMBs across five countries.
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed">
          SuiteHub was founded in Panama in 2020, but it builds on more than two decades of work in the United States, close to Spanish-speaking businesses and how they really run.
          Today it's a <strong class="text-white">PROOQ LLC</strong> (USA) product, with local operations in Panama through PROOQ S.A. Today we serve clients in the USA, Panama, and Spain, and we're just getting started in Venezuela and Colombia.
        </p>
      </div>
    </div>
  </section>

  <!-- Who we are -->
  <section class="section">
    <div class="wrap">
      <div class="grid lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7">
          <span class="eyebrow">Who we are</span>
          <h2 class="text-3xl lg:text-4xl font-display font-bold mb-5">
            <span class="text-gradient">SuiteHub</span>, one business system for several countries.
          </h2>
          <div class="space-y-4 text-ink-300 leading-relaxed">
            <p>
              <strong class="text-white">SuiteHub</strong> is a business management platform
              for SMBs in <strong class="text-white">Panama, USA, Venezuela, Spain, and Colombia</strong>. Electronic invoicing
              adapts to each country's rules, it handles multiple branches, and you can grow without switching systems.
            </p>
            <p>
              We don't resell software built for some other market. When we write SuiteHub, we're thinking about
              how a repair shop in La Chorrera invoices, how a Hispanic restaurant in Chicago gets through its day, or how a clinic in
              Bella Vista books appointments.
            </p>
            <p class="text-sm text-ink-500 pt-2">
              A <strong class="text-ink-300">PROOQ LLC</strong> (USA) product. Local operations in Panama through PROOQ S.A.
            </p>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="card-glass p-8 lg:p-10">
            <div class="grid grid-cols-2 gap-6">
              <div>
                <div class="text-3xl font-display font-bold text-brand-400">2020</div>
                <div class="text-xs text-ink-400 uppercase tracking-wider mt-1">SuiteHub founded</div>
              </div>
              <div>
                <div class="text-3xl font-display font-bold text-brand-400">+50</div>
                <div class="text-xs text-ink-400 uppercase tracking-wider mt-1">Active SMBs (PA)</div>
              </div>
              <div>
                <div class="text-3xl font-display font-bold text-brand-400">15</div>
                <div class="text-xs text-ink-400 uppercase tracking-wider mt-1">Verticals</div>
              </div>
              <div>
                <div class="text-3xl font-display font-bold text-brand-400">5</div>
                <div class="text-xs text-ink-400 uppercase tracking-wider mt-1">Target countries</div>
              </div>
            </div>
            <div class="mt-6 pt-6 border-t border-white/5 text-sm text-ink-400 space-y-1.5">
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-brand-400 w-4"></i>
                Elmwood Park, Chicago IL · USA (PROOQ LLC)
              </div>
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-brand-400 w-4"></i>
                Vía Argentina, Bella Vista · Panama
              </div>
              <div class="flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-brand-400 w-4"></i>
                Calle La Línea 15, Puerto Real · Andalucía, Spain
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="eyebrow">How we work</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">
          Four principles <span class="text-gradient">we don't compromise on.</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {values.map(v => (
          <div class="card-glass p-7">
            <div class="w-12 h-12 rounded-xl bg-brand-600/15 text-brand-400 flex items-center justify-center text-xl mb-4">
              <i class={`fa-solid ${v.icon}`}></i>
            </div>
            <h3 class="text-lg font-display font-semibold mb-2">{v.title}</h3>
            <p class="text-sm text-ink-400 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="section">
    <div class="wrap max-w-3xl">
      <div class="text-center mb-14">
        <span class="eyebrow">Our journey</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">
          From day one to <span class="text-gradient">today.</span>
        </h2>
      </div>

      <div class="relative">
        <div class="absolute left-4 lg:left-1/2 lg:-translate-x-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-brand-500 via-brand-500/50 to-transparent"></div>

        <ol class="space-y-8">
          {milestones.map((h, i) => (
            <li class={`relative pl-12 lg:pl-0 lg:grid lg:grid-cols-2 lg:gap-10 lg:items-center ${i % 2 === 0 ? '' : 'lg:flex-row-reverse'}`}>
              <div class="absolute left-0 lg:left-1/2 lg:-translate-x-1/2 top-2 w-8 h-8 rounded-full bg-brand-600 ring-4 ring-navy-950 flex items-center justify-center">
                <span class="w-2 h-2 rounded-full bg-white"></span>
              </div>

              <div class={`card-glass p-6 ${i % 2 === 0 ? 'lg:col-start-1 lg:text-right' : 'lg:col-start-2'}`}>
                <div class="text-xs uppercase tracking-[0.2em] text-brand-400 font-semibold mb-2">{h.year}</div>
                <h3 class="font-display font-semibold text-lg mb-2">{h.title}</h3>
                <p class="text-sm text-ink-400 leading-relaxed">{h.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="section bg-navy-900/30">
    <div class="wrap max-w-3xl text-center">
      <span class="eyebrow">The team</span>
      <h2 class="text-3xl lg:text-4xl font-display font-bold mb-5">
        A <span class="text-gradient">small</span> team that's easy to reach.
      </h2>
      <p class="text-ink-300 leading-relaxed mb-10">
        There aren't many of us, and together we cover development, support, and sales. When you sign up for SuiteHub, you talk
        to the people who write the code, not a call center. We think that matters.
      </p>
      <div class="card-glass p-8 lg:p-10 inline-block">
        <div class="text-sm text-ink-400 mb-3">Want to meet the team?</div>
        <a href="https://wa.me/50766326006?text=I%27d%20like%20to%20meet%20the%20SuiteHub%20team" target="_blank" rel="noopener" class="btn-primary">
          <i class="fa-brands fa-whatsapp"></i> Book a call
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="card-glass gradient-border text-center p-10 lg:p-14 max-w-3xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">
          Let's talk about <span class="text-gradient">your business.</span>
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          If you're thinking about running your business on a proper system, let's talk.
          We'll walk you through SuiteHub live and help you figure out whether it fits the way you work.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://wa.me/50766326006?text=I%27d%20like%20to%20talk%20to%20SuiteHub" target="_blank" rel="noopener" class="btn-primary">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp
          </a>
          <a href="mailto:info@suitehub.net?subject=I%27d%20like%20to%20learn%20about%20SuiteHub" class="btn-secondary">
            <i class="fa-solid fa-envelope"></i> Email
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
