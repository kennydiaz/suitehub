---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPresentaciones, bloque, imagen, ruta } from '../../lib/presentaciones';

const verticals = [
  {
    key:    'taller',
    name:   'HUB Workshop',
    icon:   'fa-screwdriver-wrench',
    sector: 'Auto repair shops',
    short:  'For mechanic shops, quick-service centers and diagnostic centers.',
    pitch:  'Fast vehicle check-in, work orders with labor and parts, online appointments and e-invoicing right from the order. Every vehicle stays linked to its owner.',
    client: 'QS Express, an auto repair shop in La Chorrera',
  },
  {
    key:    'carwash',
    name:   'HUB Carwash',
    icon:   'fa-spray-can-sparkles',
    sector: 'Car washes and detailing',
    short:  'For car washes, express wash, detailing and mobile wash.',
    pitch:  'Look up each car by its plate and see its history, run bays and washers from a live queue, reconcile the register every day and let washer commissions add up on their own. It also has stamp cards for regulars and DGI e-invoicing from the same order.',
  },
  {
    key:    'pos',
    name:   'HUB POS',
    icon:   'fa-cash-register',
    sector: 'Restaurants, bars and food trucks',
    short:  'The POS for restaurants, cafés, bars and food trucks, on your own network.',
    pitch:  'Tables and orders, kitchen display, split payments with tips, DGI e-invoices printed on the receipt with a QR code, self-service kiosk, digital menu and end-of-day cash reports by email. If the internet goes down, you keep selling.',
  },
  {
    key:    'restaurant',
    name:   'HUB Restaurant',
    icon:   'fa-utensils',
    sector: 'Full-service restaurants with dining room and tables',
    short:  'For sit-down restaurants, bars and cafés with table service.',
    pitch:  'Live table map, tickets to kitchen and bar with a KDS per station, split checks, tips, delivery and shift-based cash close. If your format is lighter, HUB POS is the starting point.',
  },
  {
    key:    'market',
    name:   'HUB Market',
    icon:   'fa-cart-shopping',
    sector: 'Minimarkets, grocery stores and supermarkets',
    short:  'For minimarkets, corner groceries and neighborhood supermarkets.',
    pitch:  'Fast barcode checkout and scale-based sales by weight, inventory with expiration dates, purchasing and suppliers, cash drawer with reconciliation and DGI electronic invoice on the receipt.',
    features: [
      { icon: 'fa-barcode',        name: 'Fast barcode checkout', desc: 'Scan and charge, no product lookup' },
      { icon: 'fa-weight-scale',   name: 'Sales by weight',       desc: 'Scale integration for produce, meat and bulk goods' },
      { icon: 'fa-calendar-xmark', name: 'Expiration tracking',   desc: 'Expiry alerts and rotation by batch' },
      { icon: 'fa-truck',          name: 'Purchasing and suppliers', desc: 'Purchase orders, receiving and payables' },
    ],
  },
  {
    key:    'boutique',
    name:   'HUB Boutique',
    icon:   'fa-shirt',
    sector: 'Clothing boutiques and fashion retail',
    short:  'For clothing, footwear and accessories boutiques with a physical and online store.',
    pitch:  'Size and color variants on a single product, touch POS, online store on the same inventory, layaway, authorized returns and DGI electronic invoicing.',
    features: [
      { icon: 'fa-table-cells',    name: 'Size × color variants', desc: 'One garment, every combination and its stock' },
      { icon: 'fa-store',          name: 'Integrated online store', desc: 'Same inventory in-store and on the web' },
      { icon: 'fa-hand-holding-dollar', name: 'Layaway',          desc: 'Installments with customer reminders' },
      { icon: 'fa-rotate-left',    name: 'Controlled returns',     desc: 'With authorization and a logged reason' },
    ],
  },
  {
    key:    'pet',
    name:   'HUB Pet',
    icon:   'fa-paw',
    sector: 'Veterinarians and pet shops',
    short:  'For vet clinics, dog grooming and pet shops.',
    pitch:  'Every pet gets a digital medical record. Vaccine and deworming reminders go out automatically, appointments keep owner and pet together, and vet products are sold with a prescription.',
    features: [
      { icon: 'fa-file-medical',   name: 'Digital medical record', desc: 'Full history, vaccines, allergies and weight' },
      { icon: 'fa-bell',           name: 'Automatic reminders',  desc: 'Upcoming vaccines, deworming and checkups' },
      { icon: 'fa-calendar-check', name: 'Owner and pet booking', desc: 'Vet visits, grooming and hospital stays' },
      { icon: 'fa-prescription',   name: 'Prescriptions with stock', desc: 'Tracks stock and controlled drug sales' },
      { icon: 'fa-camera',         name: 'Pet gallery',          desc: 'Before and after photos, X-rays' },
    ],
  },
  {
    key:    'salon',
    name:   'HUB Salon',
    icon:   'fa-scissors',
    sector: 'Beauty salons, barbershops, spas',
    short:  'For beauty salons, barbershops, spas and aesthetic centers.',
    pitch:  'Clients book online any time and only see open slots. Schedules for each stylist, automatic commissions, WhatsApp reminders, off-peak discounts and the e-invoice on the same receipt.',
  },
  {
    key:    'clinic',
    name:   'HUB Clinic',
    icon:   'fa-stethoscope',
    sector: 'Practices and clinics',
    short:  'For medical and dental practices and multi-specialty clinics.',
    pitch:  'Digital patient charts, a schedule for each doctor, e-prescriptions, patient history and insurance billing.',
    features: [
      { icon: 'fa-notes-medical',  name: 'Digital records',      desc: 'SOAP notes, medical history and vital signs' },
      { icon: 'fa-calendar-days',  name: 'Multi-doctor schedule', desc: 'By specialist, room or equipment' },
      { icon: 'fa-prescription-bottle-medical', name: 'Digital prescriptions', desc: 'Signed PDF or printed, with controlled drug tracking' },
      { icon: 'fa-shield-heart',   name: 'Health insurance',     desc: 'Bill insurers with the right codes' },
    ],
  },
  {
    key:    'gym',
    name:   'HUB Gym',
    icon:   'fa-dumbbell',
    sector: 'Gyms, crossfit and studios',
    short:  'For gyms, crossfit boxes, studios and sports centers.',
    pitch:  'The door decides on its own with the gym’s own rule, classes fill up with a waiting list and the drawer is counted blind. And every morning you get the list of members who pay and have stopped coming.',
    features: [
      { icon: 'fa-door-open',      name: 'A check-in that decides', desc: 'Membership, payments, plan hours and medical clearance' },
      { icon: 'fa-qrcode',         name: 'Kiosk at the entrance',   desc: 'The member enters their code and the screen answers' },
      { icon: 'fa-phone',          name: 'Who to call today',       desc: 'The ones paying and not coming, with reason and phone' },
      { icon: 'fa-calendar-check', name: 'Classes with capacity',   desc: 'And a waiting list that moves up if someone cancels' },
    ],
  },
  {
    key:    'clean',
    name:   'HUB Clean',
    icon:   'fa-soap',
    sector: 'Laundries and sneaker cleaning',
    short:  'For laundries and sneaker cleaning, with pickup and delivery.',
    pitch:  'One order can carry pounds of laundry, single items and pairs of sneakers at once, and each line moves at its own pace: its service, its promised date and its status. One ticket.',
    features: [
      { icon: 'fa-receipt',        name: 'Mixed order',          desc: 'Pounds, items and pairs on one ticket' },
      { icon: 'fa-shoe-prints',    name: 'Sneaker intake',       desc: 'Declared value and signed consent' },
      { icon: 'fa-camera',         name: 'Photos by area',       desc: 'The condition it came in and left with' },
      { icon: 'fa-truck',          name: 'Pickup and delivery',  desc: 'Slots with capacity and payment at the door' },
    ],
  },
  {
    key:    'inmobiliaria',
    name:   'HUB Real Estate',
    icon:   'fa-building',
    sector: 'Real estate',
    short:  'For real estate agencies and small developers.',
    pitch:  'Property listings, leads sorted by pipeline stage, rental contracts with monthly billing and commissions for each agent.',
    features: [
      { icon: 'fa-house',          name: 'Property catalog',     desc: 'Photos, video, price and status' },
      { icon: 'fa-funnel-dollar',  name: 'Lead pipeline',        desc: 'Interested → visit → offer → close' },
      { icon: 'fa-file-contract',  name: 'Rental contracts',     desc: 'Automatic monthly billing and deposits' },
      { icon: 'fa-handshake',      name: 'Agent commissions',    desc: 'Per closed sale or managed rental' },
    ],
  },
  {
    key:    'hotel',
    name:   'HUB Hotel',
    icon:   'fa-hotel',
    sector: 'Boutique hotels and hostels',
    short:  'For boutique hotels, hostels, glampings and B&Bs.',
    pitch:  'Room calendar, bookings by channel (Booking, Airbnb or direct), check-in and check-out with an invoice, minibar charges and housekeeping.',
    features: [
      { icon: 'fa-calendar',       name: 'Tape chart',           desc: 'Occupancy calendar for every room' },
      { icon: 'fa-bell-concierge', name: 'Check-in / out',       desc: 'Passport, digital signature and instant invoice' },
      { icon: 'fa-bed',            name: 'Housekeeping',         desc: 'Room status: clean, dirty or being inspected' },
      { icon: 'fa-link',           name: 'Channel manager',      desc: 'Syncs with Booking, Airbnb and Expedia (Hub Pro en adelante)' },
    ],
  },
  {
    key:    'phone',
    name:   'HUB Phone',
    icon:   'fa-mobile-screen',
    sector: 'Phone repair shops',
    short:  'For phone, tablet and laptop repair shops.',
    pitch:  'Check in each device with a diagnosis, quote based on the damage, link parts to the order, and hand over a digital warranty and a ticket with a code.',
    features: [
      { icon: 'fa-magnifying-glass', name: 'Initial diagnosis',  desc: 'Model, visible damage, passcode and accessories' },
      { icon: 'fa-money-bill-trend-up', name: 'Customer quote',  desc: 'If they approve, you fix it. If not, it goes back' },
      { icon: 'fa-microchip',      name: 'Linked parts',         desc: 'Inventory updates when a part is installed' },
      { icon: 'fa-shield',         name: 'Digital warranty',     desc: 'PDF with a QR code for future claims' },
    ],
  },
  {
    key:    'ship',
    name:   'HUB Ship',
    icon:   'fa-truck-fast',
    sector: 'Parcel delivery and last mile',
    short:  'For companies delivering parcels from a hub to the final recipient.',
    pitch:  'Receive the client load against their manifest, scan it in, dispatch by zone and deliver with a photo and the name of whoever signed. Every parcel carries its chain of custody: when something goes missing, the system says who had it and since when.',
    features: [
      { icon: 'fa-clipboard-check', name: 'Manifests',         desc: 'The client list pasted or by CSV, with shortages and overages the same day' },
      { icon: 'fa-barcode',         name: 'Scan-in',           desc: 'Scanner gun reads with an instant answer' },
      { icon: 'fa-route',           name: 'Dispatch by zone',  desc: 'Runs per driver with a printable route sheet' },
      { icon: 'fa-shield-halved',   name: 'Chain of custody',  desc: 'Who held each parcel and since when, with no way to edit it' },
      { icon: 'fa-camera',          name: 'Proof of delivery', desc: 'Photo and the name of whoever received it, with the real time' },
      { icon: 'fa-chart-line',      name: 'Service level',     desc: 'On-time and first-attempt rates, per client and per driver' },
    ],
  },
  {
    key:    'traffic',
    name:   'HUB Traffic',
    icon:   'fa-people-arrows',
    sector: 'Footfall analytics and shopper behavior',
    short:  'For retail stores, malls, brick-and-mortar locations and high-traffic venues.',
    pitch:  'Counts the people who walk in, shows heatmaps by zone and how long people stay in each one, matches visits with sales from your POS, compares hours and days, and alerts you in real time when you hit capacity.',
    features: [
      { icon: 'fa-people-line',     name: 'People counting',      desc: 'Real-time ins and outs via sensor or camera' },
      { icon: 'fa-fire',            name: 'Heatmaps',             desc: 'Busy and quiet zones by hour, day or week' },
      { icon: 'fa-stopwatch',       name: 'Dwell time',           desc: 'Average time people spend in each zone' },
      { icon: 'fa-arrow-trend-up',  name: 'Visit→sale conversion', desc: 'Matches data with HUB POS to see how many visits turn into sales' },
      { icon: 'fa-chart-column',    name: 'Comparisons',          desc: 'Peak hour, busiest day and peaks vs. average' },
      { icon: 'fa-bell',            name: 'Capacity alerts',      desc: 'Lets you know when a space goes over capacity' },
    ],
  },
  {
    key:    'time',
    name:   'HUB Time',
    icon:   'fa-clock',
    sector: 'Time and attendance tracking',
    short:  'For companies whose people work on site, across branches or on the road, away from an office.',
    pitch:  'Everyone clocks in from their own phone through a personal link: a selfie taken on the spot, their location checked against the site geofence, and the time taken from the server. The office sees the whole week, fixes things leaving a trail, approves and exports.',
  },
];

// Los verticales con página publicada toman de su presentación del panel el enlace, la captura
// y las 4 primeras funciones; los demás siguen con los datos de esta lista.
const presentaciones = await getPresentaciones();
const vista = verticals.map((v: any) => {
  const p = presentaciones[v.key];
  if (!p?.publicado || !p.hero) return v;
  return {
    ...v,
    landing: ruta(p.slug, 'en'),
    screenshot: imagen(p, p.hero.imagen),
    screenshotW: p.hero.ancho,
    screenshotH: p.hero.alto,
    features: bloque(p, 'en').funciones.slice(0, 4).map((x) => ({ icon: x.icono, name: x.titulo, desc: x.texto })),
  };
});
---
<BaseLayout title="Verticals · SuiteHub" description="17 SuiteHub verticals, one per trade: repair shop, carwash, restaurant, minimarket, boutique, salon, clinic, gym, hotel and more.">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[400px] bg-radial-brand pointer-events-none"></div>
    <div class="wrap relative pt-12 pb-16">
      <div class="text-center max-w-3xl mx-auto">
        <span class="eyebrow">17 specialized verticals</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          SuiteHub <span class="text-gradient">built for your industry</span>.
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed">
          Most of them start from the SuiteHub core, and we add the workflows, terms and screens your kind
          of business uses; a few, like HUB Time, solve a process of their own end to end. You don't pay for
          features meant for another industry.
        </p>
      </div>
    </div>
  </section>

  <!-- Index -->
  <section class="pb-12">
    <div class="wrap">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {vista.map(v => (
          <a href={v.landing ?? `#${v.key}`} class="group card-glass p-4 text-center hover:border-brand-500/30 transition-colors relative">
            {v.landing && (
              <span class="absolute top-2 right-2 text-[9px] uppercase tracking-wider font-bold text-emerald-400 bg-emerald-400/10 border border-emerald-400/30 rounded-full px-2 py-0.5">View</span>
            )}
            <img src={`/images/products/${v.key}/badge.svg`} alt={v.name} width="40" height="40" class="w-10 h-10 mx-auto mb-2 group-hover:scale-110 transition-transform" loading="lazy" />
            <div class="text-xs font-display font-semibold">{v.name}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Verticales publicados: la captura es la portada de su presentación, o sea la app real.
       Aquí no se escriben capturas a mano: las que había eran de verticales en desarrollo. -->
  <section class="section">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="eyebrow">Real screenshots</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold mt-3">See them <span class="text-gradient">from the inside</span>.</h2>
        <p class="mt-5 text-ink-300 leading-relaxed">Every screenshot comes from the running system. Open each page for the full walkthrough.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6">
        {vista.filter((v) => v.landing).map((v) => (
          <a id={v.key} href={v.landing} class="group card-glass overflow-hidden hover:border-brand-500/30 transition-colors scroll-mt-28">
            <img src={v.screenshot} alt={`Real screenshot of ${v.name}`} width={v.screenshotW} height={v.screenshotH} loading="lazy" decoding="async"
                 class="w-full aspect-[16/10] object-cover object-left-top border-b border-white/10 bg-navy-950" />
            <div class="p-6">
              <div class="flex items-center gap-3">
                <img src={`/images/products/${v.key}/badge.svg`} alt="" width="40" height="40" loading="lazy" decoding="async" class="w-10 h-10 flex-shrink-0" />
                <div>
                  <h3 class="text-lg font-display font-bold">{v.name}</h3>
                  <div class="text-xs uppercase tracking-wider text-brand-400 font-semibold">{v.sector}</div>
                </div>
              </div>
              <p class="mt-4 text-sm text-ink-300 leading-relaxed">{v.short}</p>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-400 group-hover:text-brand-300">
                See everything about {v.name} <i class="fa-solid fa-arrow-right text-xs"></i>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Los demás: sin captura hasta que su presentación se publique con pantallas reales. -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <h2 class="text-2xl font-display font-bold mb-2">More verticals</h2>
      <p class="text-sm text-ink-400 mb-8">These do not have a walkthrough page yet. Message us and we will show you how they work.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {vista.filter((v) => !v.landing).map((v) => (
          <div id={v.key} class="card-glass p-6 flex flex-col scroll-mt-28">
            <div class="flex items-center gap-3">
              <img src={`/images/products/${v.key}/badge.svg`} alt="" width="40" height="40" loading="lazy" decoding="async" class="w-10 h-10 flex-shrink-0" />
              <div>
                <h3 class="text-base font-display font-bold">{v.name}</h3>
                <div class="text-xs uppercase tracking-wider text-brand-400 font-semibold">{v.sector}</div>
              </div>
            </div>
            <p class="mt-4 text-sm text-ink-300 leading-relaxed flex-1">{v.pitch}</p>
            <a href={`https://wa.me/50766326006?text=Hello%2C%20I%27d%20like%20info%20about%20${encodeURIComponent(v.name)}`} target="_blank" rel="noopener"
               class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-400 hover:text-brand-300">
              <svg class="ico" aria-hidden="true"><use href="#i-whatsapp"></use></svg> Ask about {v.name}
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="card-glass gradient-border text-center p-10 lg:p-14 max-w-3xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">
          Is your industry <span class="text-gradient">not on the list</span>?
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          If there are 50 or more businesses like yours in any of our markets (Panama, USA, Venezuela, Spain or Colombia), we can build a vertical for you.
          Message us on WhatsApp and we'll take a look.
        </p>
        <a href="https://wa.me/50766326006?text=My%20industry%20is%20...%20can%20you%20build%20a%20vertical%3F" target="_blank" rel="noopener" class="btn-primary">
          <svg class="ico" aria-hidden="true"><use href="#i-whatsapp"></use></svg> Tell us about your industry
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
