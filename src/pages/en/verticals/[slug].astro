---
/** Page for each published vertical, generated from its panel presentation (one single template). */
import VerticalPage from '../../../components/verticales/VerticalPage.astro';
import { getPublicadas } from '../../../lib/presentaciones';
import type { Producto } from '../../../lib/presentaciones';

export async function getStaticPaths() {
  const publicadas = await getPublicadas();
  return publicadas.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Producto };
---
<VerticalPage p={p} lang="en" />
