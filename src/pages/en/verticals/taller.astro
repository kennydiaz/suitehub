---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCatalog } from '../../../lib/catalog';

const wa = (text: string) => `https://wa.me/50766326006?text=${encodeURIComponent(text)}`;
const waInfo = wa("Hi, I'd like info about HUB Taller 🔧");
const waDemo = wa("Hi, I'd like a demo of HUB Taller for my auto shop");

// Precios vivos del catálogo (panel). Respaldo local si el panel no responde en build.
const cat = await getCatalog();
const vt = (cat.verticales || []).find((v: any) => v.key === 'taller');
const precioCore = vt?.planes?.core?.precio_mes ?? 48;
const precioPro  = vt?.planes?.pro?.precio_mes ?? 64;
const anualCore  = vt?.planes?.core?.precio_anio ?? precioCore * 10;
const anualPro   = vt?.planes?.pro?.precio_anio ?? precioPro * 10;

const chips = [
  '⚡ Plate-based intake',
  '📋 Work orders',
  '📲 Customer-approved quotes',
  '🧾 DGI e-invoicing',
];

// Recorrido: cada pantalla con qué resuelve. Capturas en /public/images/products/taller.
const shots = [
  {
    img: '/images/products/taller/dashboard.webp', w: 1426, h: 718,
    title: 'Your shop at a glance',
    desc: 'Open the system and see how many cars are in the shop, which are ready for pickup, today’s appointments and the month’s billing. No need to walk the floor: it is on screen.',
    pts: ['Vehicles in shop and orders by status', 'Monthly revenue and receivables', 'Today’s appointments and what is in each bay'],
  },
  {
    img: '/images/products/taller/recepcion.webp', w: 1426, h: 718,
    title: 'Two-step intake',
    desc: 'Type the plate and the vehicle record appears with its owner and last service. Log mileage, fuel, reason, walk-around checklist and photos, and print the 80 mm receipt for the customer.',
    pts: ['If the plate does not exist, create customer and vehicle without leaving the screen', 'Printed receipt with the intake data', 'The order is numbered (OT-0001) and assigned on creation'],
  },
  {
    img: '/images/products/taller/tablero.webp', w: 1426, h: 718,
    title: 'Status board',
    desc: 'Each column is a status: received, diagnosis, pending approval, in progress, ready. Assign mechanics and see how long each car has been in. Filter by plate, customer or mechanic.',
    pts: ['Time in shop on every card', 'Quote sent and approved flags', 'Board or list, whichever you prefer'],
  },
  {
    img: '/images/products/taller/orden.webp', w: 1426, h: 718,
    title: 'The order: items, approval and log',
    desc: 'Services, parts and labor with price, tax and who approved. The log records every step with a timestamp. Quote pending items and invoice approved ones from here.',
    pts: ['An item is never invoiced twice', 'Intake and diagnosis photos attached', 'WhatsApp the customer in one tap'],
  },
  {
    img: '/images/products/taller/cotizacion-cliente.webp', w: 488, h: 718, phone: true,
    title: 'The customer approves from their phone',
    desc: 'Send the link on WhatsApp and they see the itemized quote: "Do you authorize the work for B/. 167.99?". Approve or decline with one tap, no account or app, and the order moves to "in progress" on its own.',
    pts: ['Public link with expiry, no sign-up', 'Approve, decline or ask on WhatsApp', 'Who approved and when is recorded'],
  },
  {
    img: '/images/products/taller/factura.webp', w: 1426, h: 718,
    title: 'Electronic invoice from the finished order',
    desc: 'Charge what was approved and out comes the DGI-authorized electronic invoice with CUFE and QR, 80 mm ticket or letter PDF, and a link so the customer sees it on their phone. Partial payments and credit with due date.',
    pts: ['CUFE, QR and fiscal number on the document', '80 mm ticket, PDF and WhatsApp in one click', 'Cash, card, Yappy, transfer or credit'],
  },
  {
    img: '/images/products/taller/vehiculo.webp', w: 1426, h: 718,
    title: 'Vehicle record and history',
    desc: 'Visits, current mileage, total spend and last visit. Full order history and scheduled maintenance by mileage or date, with progress bars and customer reminders.',
    pts: ['Next oil change, rotation, brakes, belt', 'Vehicle PDF report for the owner', 'Schedule a WhatsApp reminder'],
  },
  {
    img: '/images/products/taller/agenda.webp', w: 1426, h: 718,
    title: 'Schedule by mechanic and bay',
    desc: 'Week or day view, color per mechanic. Click a free slot and book by plate even if the customer does not exist yet. Bay and mechanic conflicts are blocked.',
    pts: ['Appointment → "Arrived" → intake pre-filled', 'Tomorrow’s reminders ready for WhatsApp', 'Scheduled, confirmed, arrived, no-show'],
  },
  {
    img: '/images/products/taller/movil.webp', w: 488, h: 718, phone: true,
    title: 'Mechanics work from their phones',
    desc: 'Today’s orders with a big next-step button: start, mark ready. Camera photo, quick note and the day’s schedule. No sidebar, no desk.',
    pts: ['My orders, this week and ready', 'Evidence photo in one tap', 'Their production on the profile'],
  },
];

const features = [
  { icon: 'fa-bolt',                 name: 'Plate-based intake',        desc: 'Plate → record. Mileage, fuel, reason, walk-around checklist and photos. 80 mm receipt on the spot.' },
  { icon: 'fa-clipboard-list',       name: 'Work orders',               desc: 'Services, parts and labor on one numbered order, with statuses from received to delivered.' },
  { icon: 'fa-mobile-screen-button', name: 'Customer-approved quotes',  desc: 'Built from the order; the customer approves or declines from a link on their phone, no account or app.' },
  { icon: 'fa-receipt',              name: 'DGI e-invoicing',           desc: 'Charge from the ready order: CUFE and QR through your PAC, 80 mm ticket or letter PDF, partial payments and credit.' },
  { icon: 'fa-calendar-days',        name: 'Appointments that become orders', desc: 'Book by plate, mechanic and bay. "Arrived" opens intake with everything loaded.' },
  { icon: 'fa-mobile-screen',        name: 'Mechanics on their phones', desc: 'Their orders for the day, the next-step button, camera photo and quick note.' },
  { icon: 'fa-car',                  name: 'Vehicle history',           desc: 'Visits, mileage, total spend and scheduled maintenance by mileage or date.' },
  { icon: 'fa-cash-register',        name: 'Cash and receivables',      desc: 'Shifts with cash count, who owes and since when, WhatsApp payment reminders.' },
  { icon: 'fa-chart-column',         name: 'Downloadable reports',      desc: 'Shop, money, mechanics, inventory and customers, by period and to Excel.' },
];

const benefits = [
  'DGI e-invoicing included',
  'Works on the front-desk PC and the mechanic’s phone',
  'Your shop’s data in your own database, backed up',
  'Local WhatsApp support',
  'All updates included',
  'No long-term contracts',
];

const title = 'HUB Taller — Auto shop management system in Panama';
const description = 'Plate-based intake, work orders, quotes the customer approves from their phone, scheduling by mechanic and bay, DGI e-invoicing and mechanics working from their phones. From $' + precioCore + '/month.';
---
<BaseLayout title={title} description={description} ogImage="/images/products/taller/dashboard.webp">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://suitehub.net/en/" },
      { "@type": "ListItem", "position": 2, "name": "Verticals", "item": "https://suitehub.net/en/verticals" },
      { "@type": "ListItem", "position": 3, "name": "HUB Taller", "item": "https://suitehub.net/en/verticals/taller" }
    ]
  })} />

  <!-- ░░ HERO ░░ -->
  <section class="relative overflow-hidden hero-taller">
    <div class="absolute inset-x-0 top-0 h-[460px] bg-radial-brand pointer-events-none"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none"></div>
    <div class="wrap relative pt-10 pb-10 sm:pt-14 text-center">
      <a href="/en/verticals" class="inline-flex items-center gap-2 text-xs text-ink-400 hover:text-white transition-colors mb-8">
        <i class="fa-solid fa-arrow-left"></i> All verticals
      </a>

      <div class="reveal max-w-3xl mx-auto">
        <img src="/images/products/taller/badge.svg" alt="HUB Taller" class="h-20 w-20 mx-auto mb-6" />
        <span class="eyebrow">Auto-repair shops · SuiteHub family</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          HUB <span class="text-amber-400">Taller</span>
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed max-w-2xl mx-auto">
          From intake to invoice, every car on a single work order. Plate-based intake, quotes the customer
          approves from their phone, scheduling by bay and mechanics working from their phones.
        </p>

        <div class="mt-8 flex flex-wrap gap-3 justify-center">
          <a href={waInfo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Ask about HUB Taller
          </a>
          <a href={waDemo} target="_blank" rel="noopener" class="btn-secondary">
            <i class="fa-solid fa-play"></i> Book a demo
          </a>
        </div>

        <div class="mt-9 flex flex-wrap gap-2.5 justify-center">
          {chips.map(c => (
            <span class="text-sm font-medium card-glass px-4 py-2.5">{c}</span>
          ))}
        </div>
      </div>

      <!-- Portada -->
      <div class="reveal show-glow max-w-4xl mx-auto mt-14">
        <figure class="browser">
          <div class="browser-bar">
            <span class="browser-dot bg-[#ff5f57]"></span>
            <span class="browser-dot bg-[#febc2e]"></span>
            <span class="browser-dot bg-[#28c840]"></span>
            <span class="browser-url">suitehub.net/taller</span>
          </div>
          <img src="/images/products/taller/dashboard.webp" alt="HUB Taller dashboard" width="1426" height="718" decoding="async" class="w-full h-auto" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ░░ PROBLEMA → SOLUCIÓN ░░ -->
  <section class="pt-10 pb-4">
    <div class="wrap">
      <div class="reveal max-w-2xl mx-auto text-center">
        <p class="text-ink-400">😩 Taking cars in on a notebook, quoting on WhatsApp and nobody knows what was approved?</p>
        <p class="text-2xl sm:text-3xl font-display font-bold my-4 leading-tight">
          From intake to invoice, every car on <span class="text-amber-400">a single order</span>
        </p>
        <p class="text-ink-300">
          Plate-based intake with a printed receipt, status board, quotes the customer approves from their
          phone, e-invoice on checkout and mechanics on their phones. Made in Panama 🇵🇦
        </p>
      </div>
    </div>
  </section>

  <!-- ░░ RECORRIDO ░░ -->
  <section class="section">
    <div class="wrap">
      <h2 class="text-center text-sm uppercase tracking-[0.2em] text-amber-400 font-semibold mb-16">
        What it looks like inside
      </h2>

      <div class="space-y-20 lg:space-y-28">
        {shots.map((s, i) => (
          <div class={`reveal grid gap-8 lg:gap-14 items-center ${s.phone ? 'lg:grid-cols-[1.3fr_.7fr]' : 'lg:grid-cols-2'}`}>
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <div class="flex items-center gap-3 text-amber-400 font-display font-bold text-sm tracking-widest mb-4">
                {String(i + 1).padStart(2, '0')}
                <span class="h-px w-12 bg-gradient-to-r from-amber-500 to-transparent"></span>
              </div>
              <h3 class="text-2xl lg:text-3xl font-display font-bold mb-3">{s.title}</h3>
              <p class="text-ink-300 leading-relaxed">{s.desc}</p>
              <ul class="mt-5 space-y-2">
                {s.pts.map(p => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-200">
                    <i class="fa-solid fa-check text-amber-400 mt-1"></i><span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class={`show-glow ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              {s.phone ? (
                <figure class="phone mx-auto">
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              ) : (
                <figure class="browser">
                  <div class="browser-bar">
                    <span class="browser-dot bg-[#ff5f57]"></span>
                    <span class="browser-dot bg-[#febc2e]"></span>
                    <span class="browser-dot bg-[#28c840]"></span>
                    <span class="browser-url">suitehub.net/taller</span>
                  </div>
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ FUNCIONES ░░ -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="eyebrow">Everything included</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">HUB Taller features</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {features.map(f => (
          <div class="reveal card-glass p-6 hover:border-white/15 transition-colors">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-amber-400 bg-white/5 mb-4">
              <i class={`fa-solid ${f.icon} text-lg`}></i>
            </div>
            <div class="font-display font-semibold mb-1.5">{f.name}</div>
            <div class="text-sm text-ink-400 leading-relaxed">{f.desc}</div>
          </div>
        ))}
      </div>
      <p class="mt-7 text-xs text-ink-500 text-center">
        + Every SuiteHub core function: customers, services, parts, quotes, invoices, cash and receivables.
      </p>
    </div>
  </section>

  <!-- ░░ PRECIOS ░░ -->
  <section class="section">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <span class="eyebrow">Transparent pricing</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">Two ways to get it</h2>
        <p class="text-ink-400 mt-3">Pay monthly. Pay yearly and it is 10 months. Several locations? Enterprise consolidates them.</p>
      </div>
      <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
        <div class="reveal card-glass p-7">
          <div class="text-xs uppercase tracking-wider text-ink-400 font-semibold">HUB Taller</div>
          <div class="mt-2"><span class="text-4xl font-display font-bold">${precioCore}</span><span class="text-sm text-ink-400">/mo</span></div>
          <div class="text-xs text-ink-500 mt-1">or ${anualCore} per year</div>
          <p class="text-sm text-ink-300 mt-4">Everything on this page, for one location. DGI e-invoicing included.</p>
        </div>
        <div class="reveal card-glass p-7 border-amber-500/40 shadow-glow-sm">
          <div class="text-xs uppercase tracking-wider text-amber-400 font-semibold">HUB Taller Pro</div>
          <div class="mt-2"><span class="text-4xl font-display font-bold">${precioPro}</span><span class="text-sm text-ink-400">/mo</span></div>
          <div class="text-xs text-ink-500 mt-1">or ${anualPro} per year</div>
          <p class="text-sm text-ink-300 mt-4">The same, customizable: your brand on invoices and emails, automations, API and webhooks.</p>
        </div>
      </div>
      <p class="mt-6 text-xs text-ink-500 text-center">
        You contract the e-invoicing PAC directly; we are already connected to the ones authorized by the DGI. <a href="/en/pricing" class="text-brand-400 hover:text-brand-300">See the full comparison</a>.
      </p>
    </div>
  </section>

  <!-- ░░ HABLEMOS ░░ -->
  <section class="section pt-0">
    <div class="wrap">
      <div class="reveal card-glass gradient-border max-w-3xl mx-auto p-8 lg:p-12 text-center">
        <span class="eyebrow">Let’s talk</span>
        <h2 class="text-2xl lg:text-3xl font-display font-bold mb-3">
          We set it up with your services, your mechanics and your bays.
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          We configure your account, load your services and parts catalog and train your team.
          You see HUB Taller with your data before you decide.
        </p>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-xl mx-auto text-left mb-8">
          {benefits.map(b => (
            <li class="flex items-start gap-2.5 text-sm text-ink-200">
              <i class="fa-solid fa-circle-check text-emerald-400 mt-0.5"></i>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href={waInfo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Message us on WhatsApp
          </a>
          <a href="mailto:info@suitehub.net?subject=Info%20about%20HUB%20Taller" class="btn-secondary">
            <i class="fa-solid fa-envelope"></i> info@suitehub.net
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ CTA FINAL ░░ -->
  <section class="relative overflow-hidden border-t border-white/5">
    <div class="absolute inset-x-0 bottom-0 h-[300px] bg-radial-brand pointer-events-none rotate-180"></div>
    <div class="wrap relative py-20 text-center">
      <h2 class="reveal text-3xl lg:text-4xl font-display font-bold mb-4">
        Ready to <span class="text-amber-400">take in the next car</span> without a notebook?
      </h2>
      <p class="reveal text-ink-300 mb-8 max-w-xl mx-auto">
        We run a demo with your own services, no strings attached.
      </p>
      <a href={waDemo} target="_blank" rel="noopener" class="reveal btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow text-base px-8 py-4">
        <i class="fa-brands fa-whatsapp text-xl"></i> Book your demo
      </a>
    </div>
  </section>

  <style>
    .hero-taller { background-image: linear-gradient(180deg, rgba(7,10,18,.55), #06192E 92%), url('/images/products/taller/hero.webp'); background-size: cover; background-position: center 30%; }
    .browser { border: 1px solid rgba(255,255,255,.1); border-radius: 14px; overflow: hidden; background: #0B0F1A; box-shadow: 0 38px 84px -30px rgba(0,0,0,.85); }
    .browser-bar { display: flex; align-items: center; gap: 7px; padding: 10px 13px; background: #06192E; border-bottom: 1px solid rgba(255,255,255,.08); }
    .browser-dot { width: 11px; height: 11px; border-radius: 50%; flex: none; }
    .browser-url { margin-left: 10px; font-size: 11px; color: #647088; background: #020617; border: 1px solid rgba(255,255,255,.08); border-radius: 6px; padding: 5px 12px; font-family: ui-monospace, monospace; }
    .phone { width: min(300px, 80%); border-radius: 34px; border: 8px solid #141a26; background: #000; overflow: hidden; box-shadow: 0 38px 84px -30px rgba(0,0,0,.85); }
    .show-glow { position: relative; }
    .show-glow::before { content: ''; position: absolute; inset: -2px; z-index: -1; border-radius: 16px; background: radial-gradient(60% 80% at 50% 0%, rgba(245,158,11,.30), transparent 70%); filter: blur(22px); }
    @media (max-width: 640px) { .browser-url { display: none; } }
  </style>

</BaseLayout>
