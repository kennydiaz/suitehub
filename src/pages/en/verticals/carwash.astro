---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const wa = (text: string) => `https://wa.me/50766326006?text=${encodeURIComponent(text)}`;
const waInfo = wa("Hi, I'd like info about HUB Carwash 🚗");
const waDemo = wa("Hi, I'd like a demo of HUB Carwash for my car wash");

// No prices on this page: investment is quoted per project (base system + integrations + hardware).
const chips = [
  '🧾 DGI e-invoicing',
  '🚦 5 bays live',
  '💸 Automatic commissions',
  '🎁 Loyalty included',
];

// Walkthrough: real Hub Carwash screenshots (Minimal redesign) in /public/images/products/carwash.
const shots = [
  {
    img: '/images/products/carwash/dashboard.webp', w: 1426, h: 718,
    title: 'Today\'s operation at a glance',
    desc: 'Sales for the day and the month, vehicles served, average ticket and pending commissions. Sales-per-day chart, mix by vehicle type, best-selling services and washer ranking.',
    pts: ['Vehicles served by date range', 'Best-selling services and mix by vehicle type', 'Washer ranking by commission'],
  },
  {
    img: '/images/products/carwash/nueva-orden.webp', w: 1426, h: 718,
    title: 'Intake by plate in seconds',
    desc: 'Type the plate and the system brings up the customer, their vehicle and their history. Pick the vehicle type, the wash (basic, wax or hydration), the add-ons and the bay. Total, tax and commission are calculated for you.',
    pts: ['Customer and vehicle preloaded by plate', 'Prices per vehicle type and editable add-ons', 'Bay and washer assignment on the same screen'],
  },
  {
    img: '/images/products/carwash/pistas.webp', w: 1426, h: 718,
    title: 'Five bays, live',
    desc: 'Queue board: waiting, in progress, done and delivered. Filter by bay or by washer. Each washer sees only their vehicles from their phone and advances the status with one tap.',
    pts: ['Filter by bay and by washer', 'Washer view on the phone, nothing to install', 'Vehicle counter for the day by status'],
  },
  {
    img: '/images/products/carwash/pistas-movil.webp', w: 488, h: 718, phone: true,
    title: 'The washer, from their phone',
    desc: 'Each washer logs in with their own user and sees only the vehicles assigned to them. Tap to move from "in progress" to "done" and the register knows instantly. They can also check their accumulated commission.',
    pts: ['Only their orders, nothing else', 'Advance the status with one tap', 'Their commission for the period, always visible'],
  },
  {
    img: '/images/products/carwash/caja.webp', w: 1426, h: 718,
    title: 'Cash register and daily closing',
    desc: 'Cash, card or Yappy payments, split payments and 80 mm ticket. At closing, the system compares what was sold with what was declared and records the reconciliation with the variance.',
    pts: ['80 mm thermal ticket with your logo', 'Reconciliation: declared cash vs. system', 'Management summary by email at closing'],
  },
  {
    img: '/images/products/carwash/factura.webp', w: 1426, h: 718,
    title: 'Electronic invoice with the DGI',
    desc: 'Issue the electronic invoice from the same order: CUFE, verification QR and letter or ticket format. Online RUC/DV lookup for business customers. Voiding from the panel.',
    pts: ['CUFE and DGI verification QR', 'RUC/DV lookup to invoice businesses', 'Status per order: issued, pending, voided'],
  },
  {
    img: '/images/products/carwash/cliente.webp', w: 1426, h: 718,
    title: 'Customer and vehicle history',
    desc: 'Profile with phone, tax data, registered vehicles and every visit: what was done, who washed it, how much they paid. Several vehicles per customer, each with its plate, make, model and color.',
    pts: ['Several vehicles per customer', 'Full service and payment history', 'Tax data saved for invoicing'],
  },
  {
    img: '/images/products/carwash/fidelidad.webp', w: 1426, h: 718,
    title: 'Loyalty that brings customers back',
    desc: 'Digital stamp card: every wash counts and when the goal is reached the next one is free. You set the goal. See who is close to the reward and how many free washes have been redeemed.',
    pts: ['Configurable goal (e.g. 7 washes, the 8th free)', 'Customers close to the reward, to let them know', 'Redeem directly from the order'],
  },
  {
    img: '/images/products/carwash/comisiones.webp', w: 1426, h: 718,
    title: 'Commissions without arguments',
    desc: 'Each order splits the commission among the assigned washers, at the percentage you define. The washer sees their total from their phone and you settle by period with one click.',
    pts: ['Global percentage or split per order', '"My commission" view for each washer', 'Settlement and payment record'],
  },
];

const features = [
  { icon: 'fa-bolt',           name: 'Intake by plate',           desc: 'Search by plate or name; customer, vehicle and history preloaded.' },
  { icon: 'fa-warehouse',      name: 'Bay management',            desc: 'Configurable bays, live queue by status, filter by bay and washer.' },
  { icon: 'fa-spray-can-sparkles', name: 'Wash POS',              desc: 'Vehicle types, three wash levels, add-ons with editable price, surcharges.' },
  { icon: 'fa-cash-register',  name: 'Cash and reconciliation',   desc: 'Cash, card, Yappy, split payments, 80 mm ticket, closing with variance.' },
  { icon: 'fa-receipt',        name: 'DGI e-invoicing',           desc: 'CUFE, QR, RUC/DV lookup, voiding, letter and ticket formats.' },
  { icon: 'fa-car-side',       name: 'Customers and vehicles',    desc: 'Full profile, several vehicles per customer, tax data.' },
  { icon: 'fa-medal',          name: 'Loyalty',                   desc: 'Digital stamp card with configurable goal and redemption from the order.' },
  { icon: 'fa-percent',        name: 'Commissions',               desc: 'Automatic calculation per washer, personal view and settlement by period.' },
  { icon: 'fa-chart-line',     name: 'Reports',                   desc: 'Management dashboard with charts and daily summary by email.' },
];

// Phase 2: integrations package (quoted separately, on top of the base system).
const integraciones = [
  { icon: 'fa-calendar-check', name: 'Online booking',            desc: 'Public link where the customer picks service, bay and time. Only real slots are shown.' },
  { icon: 'fa-qrcode',         name: 'Points and QR per customer', desc: 'Every customer gets a QR; scan it at intake to bring up their profile, points and membership. Points per amount, redeemable on services.' },
  { icon: 'fa-id-card',        name: 'Memberships',               desc: 'Monthly plans of N washes or unlimited, with expiry, recurring billing and usage control on the order.' },
  { icon: 'fa-comment-dots',   name: 'WhatsApp notifications',    desc: '"Your vehicle is ready", booking reminder, points earned, promotions. Official Meta API.' },
  { icon: 'fa-boxes-stacked',  name: 'Supplies inventory',        desc: 'Shampoo, wax, microfiber: stock, consumption per service, low-stock alerts.' },
  { icon: 'fa-user-clock',     name: 'Staff control',             desc: 'Attendance, shifts and hours per washer, tied to commissions.' },
  { icon: 'fa-gauge-high',     name: 'Counter per bay',           desc: 'Live vehicles per bay and average service time.' },
  { icon: 'fa-database',       name: 'MySQL database',            desc: 'Engine migration to support public booking, webhooks and several simultaneous registers.' },
];

const benefits = [
  'DGI electronic invoicing included',
  'Washers use it from their phone, nothing to install',
  'Your data in your own database, backed up',
  'Local support via WhatsApp',
  'All updates included',
  'On-site installation and training by PROOQ',
];

const title = 'HUB Carwash — Car wash management system in Panama';
const description = 'Intake by plate, live bays, cash register, automatic commissions, loyalty and DGI e-invoicing. The car wash system made in Panama.';
---
<BaseLayout title={title} description={description} ogImage="/images/products/carwash/dashboard.webp">

  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://suitehub.net/en/" },
      { "@type": "ListItem", "position": 2, "name": "Verticals", "item": "https://suitehub.net/en/verticals" },
      { "@type": "ListItem", "position": 3, "name": "HUB Carwash", "item": "https://suitehub.net/en/verticals/carwash" }
    ]
  })} />

  <!-- ░░ HERO ░░ -->
  <section class="relative overflow-hidden hero-carwash">
    <div class="absolute inset-x-0 top-0 h-[460px] bg-radial-brand pointer-events-none"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none"></div>
    <div class="wrap relative pt-10 pb-10 sm:pt-14 text-center">
      <a href="/en/verticals" class="inline-flex items-center gap-2 text-xs text-ink-400 hover:text-white transition-colors mb-8">
        <i class="fa-solid fa-arrow-left"></i> All verticals
      </a>

      <div class="reveal max-w-3xl mx-auto">
        <img src="/images/products/carwash/badge.svg" alt="HUB Carwash" class="h-20 w-20 mx-auto mb-6" />
        <span class="eyebrow">Car washes and detailing · SuiteHub family</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          The system for your car wash, <span class="text-sky-400">from intake to invoice.</span>
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed max-w-2xl mx-auto">
          Register the vehicle by plate, watch it move through the bays, charge at the register, issue the electronic
          invoice with the DGI and split commissions without spreadsheets. All in one panel, from any device.
        </p>

        <div class="mt-8 flex flex-wrap gap-3 justify-center">
          <a href={waDemo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Book a demo on WhatsApp
          </a>
          <a href="#recorrido" class="btn-secondary">
            <i class="fa-solid fa-eye"></i> See the walkthrough
          </a>
        </div>

        <div class="mt-9 flex flex-wrap gap-2.5 justify-center">
          {chips.map(c => (
            <span class="text-sm font-medium card-glass px-4 py-2.5">{c}</span>
          ))}
        </div>
      </div>

      <!-- Portada -->
      <div class="reveal show-glow max-w-4xl mx-auto mt-14">
        <figure class="browser">
          <div class="browser-bar">
            <span class="browser-dot bg-[#ff5f57]"></span>
            <span class="browser-dot bg-[#febc2e]"></span>
            <span class="browser-dot bg-[#28c840]"></span>
            <span class="browser-url">carwash.suitehub.net</span>
          </div>
          <img src="/images/products/carwash/dashboard.webp" alt="HUB Carwash dashboard" width="1426" height="718" decoding="async" class="w-full h-auto" />
        </figure>
      </div>
    </div>
  </section>

  <!-- ░░ PROBLEMA → SOLUCIÓN ░░ -->
  <section class="pt-10 pb-4">
    <div class="wrap">
      <div class="reveal max-w-2xl mx-auto text-center">
        <p class="text-ink-400">😩 Orders in a notepad, commissions in Excel and invoices by hand at the end of the day?</p>
        <p class="text-2xl sm:text-3xl font-display font-bold my-4 leading-tight">
          From plate to invoice, the whole car wash in <span class="text-sky-400">a single panel</span>
        </p>
        <p class="text-ink-300">
          Intake by plate, live bays, cash register with reconciliation, commissions calculated when each order closes
          and DGI e-invoicing from the same screen. Made in Panama 🇵🇦
        </p>
      </div>
    </div>
  </section>

  <!-- ░░ RECORRIDO ░░ -->
  <section class="section" id="recorrido">
    <div class="wrap">
      <h2 class="text-center text-sm uppercase tracking-[0.2em] text-sky-400 font-semibold mb-16">
        What it looks like inside
      </h2>

      <div class="space-y-20 lg:space-y-28">
        {shots.map((s, i) => (
          <div class={`reveal grid gap-8 lg:gap-14 items-center ${s.phone ? 'lg:grid-cols-[1.3fr_.7fr]' : 'lg:grid-cols-2'}`}>
            <div class={i % 2 === 1 ? 'lg:order-2' : ''}>
              <div class="flex items-center gap-3 text-sky-400 font-display font-bold text-sm tracking-widest mb-4">
                {String(i + 1).padStart(2, '0')}
                <span class="h-px w-12 bg-gradient-to-r from-sky-500 to-transparent"></span>
              </div>
              <h3 class="text-2xl lg:text-3xl font-display font-bold mb-3">{s.title}</h3>
              <p class="text-ink-300 leading-relaxed">{s.desc}</p>
              <ul class="mt-5 space-y-2">
                {s.pts.map(p => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-200">
                    <i class="fa-solid fa-check text-sky-400 mt-1"></i><span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class={`show-glow ${i % 2 === 1 ? 'lg:order-1' : ''}`}>
              {s.phone ? (
                <figure class="phone mx-auto">
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              ) : (
                <figure class="browser">
                  <div class="browser-bar">
                    <span class="browser-dot bg-[#ff5f57]"></span>
                    <span class="browser-dot bg-[#febc2e]"></span>
                    <span class="browser-dot bg-[#28c840]"></span>
                    <span class="browser-url">carwash.suitehub.net</span>
                  </div>
                  <img src={s.img} alt={s.title} width={s.w} height={s.h} loading="lazy" decoding="async" class="w-full h-auto" />
                </figure>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ FUNCIONES ░░ -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="eyebrow">Everything included</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">HUB Carwash features</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {features.map(f => (
          <div class="reveal card-glass p-6 hover:border-white/15 transition-colors">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-sky-400 bg-white/5 mb-4">
              <i class={`fa-solid ${f.icon} text-lg`}></i>
            </div>
            <div class="font-display font-semibold mb-1.5">{f.name}</div>
            <div class="text-sm text-ink-400 leading-relaxed">{f.desc}</div>
          </div>
        ))}
      </div>
      <p class="mt-7 text-xs text-ink-500 text-center">
        + Users and roles (admin, cashier, washer), service catalog, in-app user manual and a license managed by SuiteHub.
      </p>
    </div>
  </section>

  <!-- ░░ INTEGRACIONES (FASE 2) ░░ -->
  <section class="section">
    <div class="wrap">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <span class="eyebrow">Take it further</span>
        <h2 class="text-3xl lg:text-4xl font-display font-bold">Integrations package</h2>
        <p class="text-ink-400 mt-3">HUB Carwash grows with your business. These integrations are quoted as an add-on package on top of the base system, in full or by module.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {integraciones.map(f => (
          <div class="reveal card-glass p-6 border-dashed hover:border-sky-500/40 transition-colors">
            <div class="flex items-center justify-between mb-4">
              <div class="w-11 h-11 rounded-xl flex items-center justify-center text-sky-300 bg-sky-500/10">
                <i class={`fa-solid ${f.icon} text-lg`}></i>
              </div>
              <span class="text-[10px] uppercase tracking-wider text-sky-300/80 font-semibold border border-sky-500/30 rounded-full px-2 py-0.5">Add-on</span>
            </div>
            <div class="font-display font-semibold mb-1.5">{f.name}</div>
            <div class="text-sm text-ink-400 leading-relaxed">{f.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░ LPR (FASE 3) ░░ -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="reveal">
          <span class="eyebrow">LPR cameras</span>
          <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">Plate recognition at the entrance</h2>
          <p class="text-ink-300 leading-relaxed">
            With plate-recognition cameras the vehicle registers itself: on arrival, HUB Carwash opens the order with
            the customer and their history, and sends a WhatsApp when it is ready. PROOQ installs and configures the cameras.
          </p>
          <ul class="mt-5 space-y-2">
            {['Hikvision or Dahua ANPR cameras at the entrance', 'Local bridge on your network that sends each plate to the system', 'The order opens with customer, vehicle and history preloaded', 'Automatic notice to the customer when the vehicle is ready'].map(p => (
              <li class="flex items-start gap-2.5 text-sm text-ink-200">
                <i class="fa-solid fa-check text-sky-400 mt-1"></i><span>{p}</span>
              </li>
            ))}
          </ul>
          <p class="mt-6 text-xs text-ink-500">Requires a local network and on-site installation. Quoted together with the hardware.</p>
        </div>

        <div class="reveal card-glass p-6 lg:p-8">
          <svg viewBox="0 0 640 200" class="w-full h-auto" role="img" aria-label="Diagram: LPR camera, local bridge, HUB Carwash in the cloud, intake and WhatsApp to the customer">
            <defs>
              <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 0L10 5 0 10z" fill="#38BDF8"/>
              </marker>
            </defs>
            {[
              { x: 10,  t1: 'LPR camera',     t2: 'at the entrance',     icon: '📷' },
              { x: 175, t1: 'Local bridge',   t2: 'mini PC on your LAN', icon: '🖥️' },
              { x: 340, t1: 'HUB Carwash',    t2: 'in the cloud',        icon: '☁️' },
              { x: 505, t1: 'Intake',         t2: '+ WhatsApp',        icon: '💬' },
            ].map(n => (
              <g>
                <rect x={n.x} y="40" width="125" height="120" rx="16" fill="rgba(255,255,255,.04)" stroke="rgba(56,189,248,.35)"/>
                <text x={n.x + 62.5} y="86" text-anchor="middle" font-size="30">{n.icon}</text>
                <text x={n.x + 62.5} y="118" text-anchor="middle" font-size="13" font-weight="700" fill="#F8FAFC" font-family="Sora, Inter, sans-serif">{n.t1}</text>
                <text x={n.x + 62.5} y="138" text-anchor="middle" font-size="11" fill="#94A3B8" font-family="Inter, sans-serif">{n.t2}</text>
              </g>
            ))}
            <path d="M135 100 H173" stroke="#38BDF8" stroke-width="2" marker-end="url(#arr)"/>
            <path d="M300 100 H338" stroke="#38BDF8" stroke-width="2" marker-end="url(#arr)"/>
            <path d="M465 100 H503" stroke="#38BDF8" stroke-width="2" marker-end="url(#arr)"/>
            <text x="154" y="90" text-anchor="middle" font-size="9" fill="#64748B" font-family="Inter, sans-serif">plate</text>
            <text x="319" y="90" text-anchor="middle" font-size="9" fill="#64748B" font-family="Inter, sans-serif">HTTPS</text>
            <text x="484" y="90" text-anchor="middle" font-size="9" fill="#64748B" font-family="Inter, sans-serif">order</text>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ HABLEMOS ░░ -->
  <section class="section">
    <div class="wrap">
      <div class="reveal card-glass gradient-border max-w-3xl mx-auto p-8 lg:p-12 text-center">
        <span class="eyebrow">Let's talk</span>
        <h2 class="text-2xl lg:text-3xl font-display font-bold mb-3">
          Opening a car wash, or want to get the one you have in order?
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          We show you HUB Carwash running with your services and your bays. We set up your account, load your catalog
          and your washers with their commissions, and train your team. Quoted per project depending on the integrations you need.
        </p>
        <ul class="grid sm:grid-cols-2 gap-x-8 gap-y-3 max-w-xl mx-auto text-left mb-8">
          {benefits.map(b => (
            <li class="flex items-start gap-2.5 text-sm text-ink-200">
              <i class="fa-solid fa-circle-check text-emerald-400 mt-0.5"></i>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href={waInfo} target="_blank" rel="noopener" class="btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow-sm">
            <i class="fa-brands fa-whatsapp text-lg"></i> Message us on WhatsApp
          </a>
          <a href="mailto:info@suitehub.net?subject=Info%20about%20HUB%20Carwash" class="btn-secondary">
            <i class="fa-solid fa-envelope"></i> info@suitehub.net
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░ CTA FINAL ░░ -->
  <section class="relative overflow-hidden border-t border-white/5">
    <div class="absolute inset-x-0 bottom-0 h-[300px] bg-radial-brand pointer-events-none rotate-180"></div>
    <div class="wrap relative py-20 text-center">
      <h2 class="reveal text-3xl lg:text-4xl font-display font-bold mb-4">
        Ready to see your bays <span class="text-sky-400">live</span>?
      </h2>
      <p class="reveal text-ink-300 mb-8 max-w-xl mx-auto">
        We'll do a demo with your services and your bays, no strings attached.
      </p>
      <a href={waDemo} target="_blank" rel="noopener" class="reveal btn bg-emerald-500 text-white hover:bg-emerald-400 shadow-glow text-base px-8 py-4">
        <i class="fa-brands fa-whatsapp text-xl"></i> Book your demo
      </a>
    </div>
  </section>

  <style>
    .hero-carwash { background-image: radial-gradient(60% 50% at 50% 0%, rgba(2,132,199,.30), transparent 70%), linear-gradient(180deg, #071A2B, #06192E 92%); }
    .browser { border: 1px solid rgba(255,255,255,.1); border-radius: 14px; overflow: hidden; background: #0B0F1A; box-shadow: 0 38px 84px -30px rgba(0,0,0,.85); }
    .browser-bar { display: flex; align-items: center; gap: 7px; padding: 10px 13px; background: #06192E; border-bottom: 1px solid rgba(255,255,255,.08); }
    .browser-dot { width: 11px; height: 11px; border-radius: 50%; flex: none; }
    .browser-url { margin-left: 10px; font-size: 11px; color: #647088; background: #020617; border: 1px solid rgba(255,255,255,.08); border-radius: 6px; padding: 5px 12px; font-family: ui-monospace, monospace; }
    .phone { width: min(300px, 80%); border-radius: 34px; border: 8px solid #141a26; background: #000; overflow: hidden; box-shadow: 0 38px 84px -30px rgba(0,0,0,.85); }
    .show-glow { position: relative; }
    .show-glow::before { content: ''; position: absolute; inset: -2px; z-index: -1; border-radius: 16px; background: radial-gradient(60% 80% at 50% 0%, rgba(2,132,199,.32), transparent 70%); filter: blur(22px); }
    @media (max-width: 640px) { .browser-url { display: none; } }
  </style>

</BaseLayout>
