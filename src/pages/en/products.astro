---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEdiciones } from '../../lib/catalog';

const editions = [
  {
    key:        'lite',
    name:       'Lite Edition',
    tagline:    'Starter',
    price:      24,
    priceYearly: 240,
    color:      'sky',
    icon:       'fa-rocket',
    ideal:      'Small businesses just starting to go digital, like an independent practice, a small distributor or a freelancer with regular clients.',
    description:'What you need to get organized. Your customers, products and services live in one place, your quotes look professional, and DGI electronic invoicing is already included. We don\'t pile on features you won\'t use.',
    limits: {
      branches: 1, users: 3, records: 500, storage: '2 GB',
    },
    modules: [
      { icon: 'fa-users',         name: 'Customers',      desc: 'Add, edit, search and filter' },
      { icon: 'fa-screwdriver-wrench', name: 'Services', desc: 'Catalog of billable services' },
      { icon: 'fa-boxes-stacked', name: 'Inventory',      desc: 'Products with manual stock' },
      { icon: 'fa-file-invoice',  name: 'Quotes',         desc: 'Up to 50 quotes/month' },
      { icon: 'fa-receipt',       name: 'E-invoicing',    desc: 'Up to 100 invoices/month with DGI e-invoicing' },
      { icon: 'fa-chart-line',    name: 'Reports',        desc: '6 pre-built reports with filters' },
    ],
    extras: ['Email support', 'Automatic updates', 'Daily backup'],
  },
  {
    key:        'core',
    name:       'Core Edition',
    tagline:    'Best seller',
    price:      48,
    priceYearly: 480,
    color:      'cyan',
    featured:   true,
    icon:       'fa-bolt',
    ideal:      'Established small businesses with 5 to 10 employees and a single location. Think the neighborhood restaurant, a clinic with its own practice, or a regional distributor.',
    description:'Core is where you turn on electronic invoicing through any of the 5 PACs certified by Panama\'s DGI (Digifact, HKA, Ebi, Factura Fácil, eFacturapty), or through The Factory HKA Venezuela if you invoice under the SENIAT regime. You also get accounts receivable with receipts that cover several invoices, and saved SQL reports for anyone who wants to dig into the numbers. It\'s built for one location. Once you open a second, you\'ll want Enterprise.',
    limits: {
      branches: 1, users: 8, records: 5000, storage: '10 GB',
    },
    modules: [
      { icon: 'fa-receipt',           name: 'DGI electronic invoicing', desc: '32 DGI rules verified, 0 production rejections' },
      { icon: 'fa-hand-holding-dollar', name: 'AR with multi-invoice receipts', desc: 'One payment applied across several invoices' },
      { icon: 'fa-file-invoice',      name: 'Quotes with conversion',   desc: 'Turn an accepted quote into an invoice in 1 click' },
      { icon: 'fa-arrow-right-arrow-left', name: 'Inventory movements', desc: 'Stock in, stock out and adjustments, all audited' },
      { icon: 'fa-chart-column',      name: 'Level 2 reports (SQL)',    desc: 'Admins save SELECT queries against a whitelist' },
      { icon: 'fa-file-pdf',          name: 'Editable PDF templates',   desc: 'Customize invoice, quote and receipt' },
    ],
    extras: ['Email + WhatsApp support', 'Installable PWA', 'Guided setup'],
  },
  {
    key:        'pro',
    name:       'Pro Edition',
    tagline:    'Customizable',
    price:      64,
    priceYearly: 640,
    color: 'brand',
    icon:       'fa-crown',
    ideal:      'Businesses with 10 to 20 employees that want the system set up their way, with their brand on every invoice, automations, and a link to their accounting or online store.',
    description:'This is where the system starts to carry your brand. Your logo, colors and domain show up on invoices, emails and the portal. You can schedule automations like payment reminders and follow-ups, connect your accounting or e-commerce through the REST API, and message customers on WhatsApp Business without leaving the system.',
    limits: {
      branches: 1, users: 20, records: 50000, storage: '50 GB',
    },
    modules: [
      { icon: 'fa-palette',      name: 'Your own branding',       desc: 'Your logo, colors and domain on invoices, emails and portal' },
      { icon: 'fa-robot',        name: 'Automations',             desc: 'Payment reminders, follow-ups, stock alerts' },
      { icon: 'fa-code',         name: 'REST API',                desc: '100,000 calls/month with OpenAPI 3.0' },
      { icon: 'fa-comments',     name: 'WhatsApp Business',       desc: 'Meta-approved templates and automatic sending' },
      { icon: 'fa-bolt',         name: 'Webhooks',                desc: 'Let your other systems know the moment something happens' },
      { icon: 'fa-chart-pie',    name: 'Level 3 reports (PDF)',   desc: 'Dynamic templates with editable placeholders' },
    ],
    extras: ['Priority support', 'Assisted onboarding (4h)', 'Initial training'],
  },
  {
    key:        'enterprise',
    name:       'Enterprise Edition',
    tagline:    'Branches',
    price:      196,
    priceYearly: 1960,
    color:      'amber',
    icon:       'fa-trophy',
    ideal:      'Businesses with several locations, like a chain of repair shops, a restaurant with 3 locations or a medical group with several practices. Your main location is included, and each additional one is $64/mo.',
    description:'Built for running several branches. You see inventory, sales and reports per branch or all together, transfer stock between locations, and get any vertical included. It also comes with full white-label so you can sell SuiteHub under your own brand, plus unlimited API, an SLA, dedicated onboarding and custom integrations.',
    limits: {
      branches: '1 + $64/mo each additional', users: 50, records: 'Unlimited', storage: '200 GB',
    },
    modules: [
      { icon: 'fa-building',        name: 'Multi-branch',             desc: 'Inventory, sales and reports per branch or consolidated' },
      { icon: 'fa-palette',         name: 'Full white-label',         desc: 'Sell SuiteHub under your own brand and domain' },
      { icon: 'fa-code-branch',     name: 'Unlimited API',            desc: 'No call cap, bidirectional webhooks' },
      { icon: 'fa-arrows-up-down-left-right', name: 'Inter-branch transfers', desc: 'Out and in recorded as one audited step' },
      { icon: 'fa-graduation-cap',  name: 'Dedicated onboarding',     desc: 'A SuiteHub consultant assigned to you, plus a migration plan' },
      { icon: 'fa-plug',            name: 'Custom integrations',      desc: 'Hook into the systems your company already uses' },
    ],
    extras: ['Contractual SLA', 'Dedicated account manager', 'Geographic backup (Tier 3)'],
  },
];

// Prices from the panel's canonical catalog (with local fallback).
const _ed = await getEdiciones();
for (const e of editions) {
  const c = _ed[e.key];
  if (!c) continue;
  e.price = c.precio_mes;
  if ('yearly' in e) e.yearly = c.precio_anio;
  if ('priceYearly' in e) e.priceYearly = c.precio_anio;
}

const colorMap = {
  sky:    { bg: 'from-sky-500/10', border: 'border-sky-500/30', text: 'text-sky-400', dot: 'bg-sky-400' },
  cyan:   { bg: 'from-cyan-500/10', border: 'border-cyan-500/30', text: 'text-cyan-400', dot: 'bg-cyan-400' },
  brand: { bg: 'from-brand-500/15', border: 'border-brand-500/40', text: 'text-brand-300', dot: 'bg-brand-400' },
  amber:  { bg: 'from-amber-500/10', border: 'border-amber-500/30', text: 'text-amber-400', dot: 'bg-amber-400' },
};
---
<BaseLayout title="Editions · SuiteHub" description="SuiteHub comes in four editions: Lite ($24), Core ($48), Pro ($64) and Enterprise ($196). As you grow, you switch editions without migrating.">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[400px] bg-radial-brand pointer-events-none"></div>
    <div class="wrap relative pt-12 pb-20">
      <div class="text-center max-w-3xl mx-auto">
        <span class="eyebrow">The 4 editions</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          It's one platform, and <span class="text-gradient">you decide</span> how much of it you need.
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed">
          Every edition runs on the same foundation, and your data stays where it is. Switching editions is just a change to your account, so you never have to move to another system.
        </p>
      </div>
    </div>
  </section>

  <!-- Platform showcase -->
  <section class="pb-12 -mt-6">
    <div class="wrap">
      <figure class="max-w-5xl mx-auto rounded-2xl overflow-hidden border border-white/10 shadow-glow bg-navy-950">
        <img src="/images/products/suite/web-1280.webp" alt="SuiteHub platform interface" width="1280" height="762" loading="eager" decoding="async" class="w-full h-auto" />
      </figure>
      <p class="text-center text-xs text-ink-500 mt-4">All 4 editions run on this same platform, so moving between them doesn't require a migration.</p>
    </div>
  </section>

  {editions.map((ed, i) => {
    const c = colorMap[ed.color];
    return (
      <section id={ed.key} class={`section relative ${i % 2 === 1 ? 'bg-navy-900/30' : ''}`}>
        <div class="wrap">
          <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
            <div class="lg:col-span-5 lg:sticky lg:top-28 self-start">
              <div class={`text-xs uppercase tracking-wider ${c.text} font-semibold mb-3`}>
                <i class={`fa-solid ${ed.icon} mr-1`}></i> {ed.tagline}
              </div>
              <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">{ed.name}</h2>
              <p class="text-base text-ink-300 leading-relaxed mb-3">{ed.description}</p>
              <p class="text-sm text-ink-400 italic mb-6">
                <strong class="text-ink-200">Ideal for:</strong> {ed.ideal}
              </p>

              <div class={`rounded-2xl border ${c.border} bg-gradient-to-b ${c.bg} to-transparent p-6 mb-6`}>
                <div class="flex items-baseline gap-2">
                  <span class="text-5xl font-display font-bold">${ed.price}</span>
                  <span class="text-base text-ink-400">/mo</span>
                </div>
                <p class={`text-sm ${c.text} mt-1`}>
                  or ${ed.priceYearly} a year <span class="text-ink-500">(16% off)</span>
                </p>
              </div>

              <div class="grid grid-cols-2 gap-3 mb-6">
                <div class="card-glass p-3">
                  <div class="text-[10px] uppercase tracking-wider text-ink-500">Branches</div>
                  <div class="text-lg font-display font-semibold mt-0.5">{ed.limits.branches}</div>
                </div>
                <div class="card-glass p-3">
                  <div class="text-[10px] uppercase tracking-wider text-ink-500">Users</div>
                  <div class="text-lg font-display font-semibold mt-0.5">{ed.limits.users}</div>
                </div>
                <div class="card-glass p-3">
                  <div class="text-[10px] uppercase tracking-wider text-ink-500">Records</div>
                  <div class="text-lg font-display font-semibold mt-0.5">{ed.limits.records}</div>
                </div>
                <div class="card-glass p-3">
                  <div class="text-[10px] uppercase tracking-wider text-ink-500">Storage</div>
                  <div class="text-lg font-display font-semibold mt-0.5">{ed.limits.storage}</div>
                </div>
              </div>

              <a href={`https://wa.me/50766326006?text=Hello%2C%20I%27d%20like%20info%20about%20${encodeURIComponent(ed.name)}`}
                 target="_blank" rel="noopener" class="btn-primary w-full">
                <i class="fa-brands fa-whatsapp text-xl"></i>
                Get a quote for {ed.name}
              </a>
            </div>

            <div class="lg:col-span-7">
              <h3 class="text-xs uppercase tracking-[0.2em] text-brand-400 font-semibold mb-5">Modules included</h3>
              <div class="grid sm:grid-cols-2 gap-3">
                {ed.modules.map(m => (
                  <div class="card-glass p-5 flex items-start gap-3 hover:border-white/15 transition-colors">
                    <div class={`w-10 h-10 rounded-lg flex items-center justify-center ${c.text} bg-white/5 flex-shrink-0`}>
                      <i class={`fa-solid ${m.icon}`}></i>
                    </div>
                    <div>
                      <div class="font-display font-semibold text-sm">{m.name}</div>
                      <div class="text-xs text-ink-400 mt-1 leading-relaxed">{m.desc}</div>
                    </div>
                  </div>
                ))}
              </div>

              <div class="mt-6 flex flex-wrap gap-2">
                {ed.extras.map(x => (
                  <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-full bg-white/5 border border-white/10 text-ink-300">
                    <span class={`w-1.5 h-1.5 rounded-full ${c.dot}`}></span>
                    {x}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section">
    <div class="wrap">
      <div class="card-glass gradient-border p-10 lg:p-14 text-center max-w-3xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">
          Not sure <span class="text-gradient">which one to pick</span>?
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          Check the <a href="/en/pricing" class="text-brand-400 hover:text-brand-300">full comparison table</a> or message us on WhatsApp. A 10-minute chat is usually enough for us to tell you which edition fits your business.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/en/pricing" class="btn-secondary"><i class="fa-solid fa-table-list"></i> See comparison table</a>
          <a href="https://wa.me/50766326006?text=Hello%2C%20I%27m%20not%20sure%20which%20edition%20fits" target="_blank" rel="noopener" class="btn-primary">
            <i class="fa-brands fa-whatsapp"></i> Get a recommendation
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
