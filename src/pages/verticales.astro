---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPresentaciones, bloque, imagen, ruta } from '../lib/presentaciones';

const verticales = [
  {
    key:    'taller',
    name:   'HUB Taller',
    icon:   'fa-screwdriver-wrench',
    sector: 'Talleres mecánicos',
    short:  'Para talleres mecánicos, autoservicios y centros de diagnóstico.',
    pitch:  'Recepción rápida del vehículo, órdenes de trabajo con servicios y repuestos, citas en línea y factura electrónica desde la misma orden. Cada vehículo queda ligado a su dueño.',
    cliente: 'QS Express, taller mecánico en La Chorrera',
  },
  {
    key:    'carwash',
    name:   'HUB Carwash',
    icon:   'fa-spray-can-sparkles',
    sector: 'Autolavados y car wash',
    short:  'Para autolavados, car wash express, detailing y lavado a domicilio.',
    pitch:  'Recibes el carro por la placa y ves su historial, manejas pistas y lavadores con la cola en vivo, cierras caja con arqueo diario y las comisiones de cada lavador salen solas. También trae tarjeta de sellos y factura electrónica DGI desde la misma orden.',
  },
  {
    key:    'pos',
    name:   'HUB POS',
    icon:   'fa-cash-register',
    sector: 'Restaurantes, bares y food trucks',
    short:  'El POS para restaurantes, cafeterías, bares y food trucks, en tu propia red.',
    pitch:  'Mesas y pedidos, monitor de cocina, cobro mixto con propina, factura electrónica DGI en ticket con QR, kiosko de autoservicio, menú digital y cierre de caja por correo. Si se cae el internet, sigues vendiendo.',
  },
  {
    key:    'restaurant',
    name:   'HUB Restaurant',
    icon:   'fa-utensils',
    sector: 'Restaurantes full-service con salón y mesas',
    short:  'Para restaurantes de salón, bares y cafeterías con servicio a la mesa.',
    pitch:  'Mapa de mesas en tiempo real, comandas a cocina y barra con monitor KDS por estación, cuentas divididas, propinas, delivery y cierre de caja por turno. Si tu formato es más ligero, HUB POS es tu punto de partida.',
  },
  {
    key:    'market',
    name:   'HUB Market',
    icon:   'fa-cart-shopping',
    screenshot: '/images/products/market/web-1280.webp',
    screenshotH: 940,
    sector: 'Minimarkets, abarroterías y supermercados',
    short:  'Para minimarkets, abarroterías y supermercados de barrio.',
    pitch:  'Venta rápida por código de barras y por peso con balanza, inventario con fechas de caducidad, compras y proveedores, caja con arqueo y factura electrónica DGI en el ticket.',
    features: [
      { icon: 'fa-barcode',        name: 'Venta rápida por código', desc: 'Escaneas y cobras, sin buscar el producto' },
      { icon: 'fa-weight-scale',   name: 'Venta por peso',          desc: 'Integración con balanza para frutas, carnes y granel' },
      { icon: 'fa-calendar-xmark', name: 'Inventario con caducidad', desc: 'Alertas de vencimiento y rotación por lote' },
      { icon: 'fa-truck',          name: 'Compras y proveedores',   desc: 'Órdenes de compra, recepción y cuentas por pagar' },
    ],
  },
  {
    key:    'boutique',
    name:   'HUB Boutique',
    icon:   'fa-shirt',
    sector: 'Boutiques de ropa y retail de moda',
    short:  'Para boutiques de ropa, calzado y accesorios con tienda física y online.',
    pitch:  'Variantes de talla y color en un solo producto, POS táctil, tienda online sobre el mismo inventario, apartados (layaway), devoluciones con autorización y factura electrónica DGI.',
    features: [
      { icon: 'fa-table-cells',    name: 'Variantes talla × color', desc: 'Una prenda, todas sus combinaciones y su stock' },
      { icon: 'fa-store',          name: 'Tienda online integrada', desc: 'El mismo inventario en la tienda física y en la web' },
      { icon: 'fa-hand-holding-dollar', name: 'Apartados',          desc: 'Layaway con abonos y recordatorios al cliente' },
      { icon: 'fa-rotate-left',    name: 'Devoluciones controladas', desc: 'Con autorización y motivo registrado' },
    ],
  },
  {
    key:    'pet',
    name:   'HUB Pet',
    icon:   'fa-paw',
    screenshot: '/images/products/pet/web-1280.webp',
    screenshotH: 994,
    sector: 'Veterinarias y pet shops',
    short:  'Para clínicas veterinarias, peluquerías caninas y pet shops.',
    pitch:  'Cada mascota tiene su ficha médica digital. Los recordatorios de vacunas y desparasitación salen solos, la agenda guarda dueño y mascota juntos y los productos veterinarios se venden con receta.',
    features: [
      { icon: 'fa-file-medical',   name: 'Ficha médica digital', desc: 'Historial completo, vacunas, alergias y peso' },
      { icon: 'fa-bell',           name: 'Recordatorios automáticos', desc: 'Próxima vacuna, desparasitación y controles' },
      { icon: 'fa-calendar-check', name: 'Agenda por dueño y mascota', desc: 'Consultas, peluquería y hospitalización' },
      { icon: 'fa-prescription',   name: 'Recetas con stock',    desc: 'Descuenta el medicamento y controla la venta regulada' },
      { icon: 'fa-camera',         name: 'Galería por mascota',  desc: 'Fotos de antes y después, radiografías' },
    ],
  },
  {
    key:    'salon',
    name:   'HUB Salon',
    icon:   'fa-scissors',
    sector: 'Salones de belleza, barberías y spas',
    short:  'Para salones de belleza, barberías, spas y centros estéticos.',
    pitch:  'Tus clientes reservan en línea a cualquier hora y solo ven los espacios libres. Agenda por estilista, comisiones automáticas, recordatorios por WhatsApp, descuentos en las horas de poco movimiento y factura electrónica en el mismo ticket.',
  },
  {
    key:    'clinic',
    name:   'HUB Clinic',
    icon:   'fa-stethoscope',
    screenshot: '/images/products/clinic/hub-clinic-dashboard.webp',
    screenshotH: 940,
    sector: 'Consultorios y clínicas',
    short:  'Para consultorios médicos, odontológicos y clínicas multi-especialidad.',
    pitch:  'Expediente clínico digital, agenda por médico, recetas electrónicas, historial de cada paciente y facturación a las aseguradoras.',
    features: [
      { icon: 'fa-notes-medical',  name: 'Expediente digital',   desc: 'SOAP, antecedentes y signos vitales' },
      { icon: 'fa-calendar-days',  name: 'Agenda de varios médicos', desc: 'Por especialista, sala o equipo' },
      { icon: 'fa-prescription-bottle-medical', name: 'Recetas digitales', desc: 'En PDF firmado o impresas, con control de medicamentos regulados' },
      { icon: 'fa-shield-heart',   name: 'Seguros médicos',      desc: 'Facturas a las aseguradoras con sus códigos' },
    ],
  },
  {
    key:    'gym',
    name:   'HUB Gym',
    icon:   'fa-dumbbell',
    screenshot: '/images/products/gym/hub-gym-dashboard.webp',
    screenshotH: 940,
    sector: 'Gimnasios, crossfit y yoga',
    short:  'Para gimnasios, boxes de crossfit, estudios de yoga y centros deportivos.',
    pitch:  'Membresías mensuales o anuales, entrada con QR, clases con cupo limitado y entrenadores asignados. Si un miembro deja de venir, el sistema te avisa.',
    features: [
      { icon: 'fa-id-card',        name: 'Membresías',           desc: 'Cobro recurrente, congelación y suspensión' },
      { icon: 'fa-qrcode',         name: 'Control de acceso',    desc: 'El cliente entra escaneando el QR de su app' },
      { icon: 'fa-people-group',   name: 'Clases con cupo',      desc: 'Reserva en línea y lista de espera' },
      { icon: 'fa-chart-line',     name: 'Retención',            desc: 'Te avisa si un miembro lleva 14 días sin venir' },
    ],
  },
  {
    key:    'lavanderia',
    name:   'HUB Lavandería',
    icon:   'fa-soap',
    screenshot: '/images/products/lavanderia/hub-lavanderia-dashboard.webp',
    screenshotH: 940,
    sector: 'Lavanderías profesionales',
    short:  'Para lavanderías, tintorerías y servicios de planchado.',
    pitch:  'Boleta con código de retiro, seguimiento de cada etapa (lavado, secado, planchado), precio por kilo o por prenda y aviso al cliente cuando su ropa está lista.',
    features: [
      { icon: 'fa-receipt',        name: 'Boleta con código',    desc: 'El cliente retira con su propio código' },
      { icon: 'fa-spinner',        name: 'Etapas del proceso',   desc: 'Recibido → lavado → secado → listo' },
      { icon: 'fa-weight-hanging', name: 'Precio por kilo o prenda', desc: 'Lo defines para cada servicio' },
      { icon: 'fa-mobile-screen',  name: 'Aviso por WhatsApp',   desc: 'Mensaje automático cuando está listo' },
    ],
  },
  {
    key:    'inmobiliaria',
    name:   'HUB Inmobiliaria',
    icon:   'fa-building',
    screenshot: '/images/products/inmobiliaria/hub-inmobiliaria-dashboard.webp',
    screenshotH: 940,
    sector: 'Bienes raíces',
    short:  'Para corredoras inmobiliarias y desarrolladoras pequeñas.',
    pitch:  'Cartera de propiedades, leads ordenados por etapa, contratos de alquiler con cobro mensual y comisiones por agente.',
    features: [
      { icon: 'fa-house',          name: 'Catálogo de propiedades', desc: 'Fotos, video, precio y estado' },
      { icon: 'fa-funnel-dollar',  name: 'Pipeline de leads',    desc: 'Interesado → visita → oferta → cierre' },
      { icon: 'fa-file-contract',  name: 'Contratos de alquiler', desc: 'Cobro mensual automático y depósitos de garantía' },
      { icon: 'fa-handshake',      name: 'Comisiones de agentes', desc: 'Por venta cerrada o alquiler gestionado' },
    ],
  },
  {
    key:    'hotel',
    name:   'HUB Hotel',
    icon:   'fa-hotel',
    screenshot: '/images/products/hotel/web-1200.webp',
    screenshotH: 922,
    sector: 'Hoteles boutique y hostales',
    short:  'Para hoteles boutique, hostales, glampings y B&B.',
    pitch:  'Calendario de habitaciones, reservas por canal (Booking, Airbnb o directas), check-in y check-out con factura, consumos de minibar y control de limpieza.',
    features: [
      { icon: 'fa-calendar',       name: 'Tape chart',           desc: 'Calendario de ocupación por habitación' },
      { icon: 'fa-bell-concierge', name: 'Check-in / out',       desc: 'Pasaporte, firma digital y factura al momento' },
      { icon: 'fa-bed',            name: 'Housekeeping',         desc: 'Estado de cada habitación: limpia, sucia o en inspección' },
      { icon: 'fa-link',           name: 'Channel manager',      desc: 'Se sincroniza con Booking, Airbnb y Expedia (Hub Pro en adelante)' },
    ],
  },
  {
    key:    'phone',
    name:   'HUB Phone',
    icon:   'fa-mobile-screen',
    screenshot: '/images/products/phone/hub-phone-dashboard.webp',
    screenshotH: 940,
    sector: 'Reparación de celulares',
    short:  'Para tiendas de reparación de celulares, tablets y laptops.',
    pitch:  'Recibes el equipo con su diagnóstico, cotizas según el daño, ligas los repuestos a la orden y entregas garantía digital y ticket con código.',
    features: [
      { icon: 'fa-magnifying-glass', name: 'Diagnóstico inicial', desc: 'Modelo, daño visible, contraseña y accesorios' },
      { icon: 'fa-money-bill-trend-up', name: 'Cotización al cliente', desc: 'Si la aprueba, se repara. Si no, se le devuelve el equipo' },
      { icon: 'fa-microchip',      name: 'Repuestos vinculados',  desc: 'El inventario se descuenta al instalar' },
      { icon: 'fa-shield',         name: 'Garantía digital',      desc: 'PDF con QR por si hay un reclamo' },
    ],
  },
  {
    key:    'traffic',
    name:   'HUB Traffic',
    icon:   'fa-people-arrows',
    screenshot: '/images/products/traffic/hub-traffic-dashboard.webp',
    screenshotH: 940,
    sector: 'Analítica de afluencia y conducta en tienda',
    short:  'Para tiendas, centros comerciales, locales retail y espacios de alto tráfico.',
    pitch:  'Cuenta cuántas personas entran, muestra mapas de calor por zona y cuánto tiempo pasa la gente en cada una, cruza las visitas con las ventas de tu POS, compara horas y días, y te avisa en tiempo real si se supera el aforo.',
    features: [
      { icon: 'fa-people-line',     name: 'Conteo de afluencia',  desc: 'Entradas y salidas en tiempo real con sensor o cámara' },
      { icon: 'fa-fire',            name: 'Mapas de calor',        desc: 'Zonas con más y menos movimiento por hora, día o semana' },
      { icon: 'fa-stopwatch',       name: 'Tiempo de permanencia', desc: 'Tiempo promedio que la gente pasa en cada zona' },
      { icon: 'fa-arrow-trend-up',  name: 'Conversión visita→venta', desc: 'Cruza los datos con HUB POS para ver cuántas visitas terminan en compra' },
      { icon: 'fa-chart-column',    name: 'Comparativas',          desc: 'Hora pico, día más fuerte y picos frente al promedio' },
      { icon: 'fa-bell',            name: 'Alertas de aforo',      desc: 'Aviso cuando se supera el límite de personas' },
    ],
  },
];

// Los verticales con página publicada toman de su presentación del panel el enlace, la captura
// y las 4 primeras funciones; los demás siguen con los datos de esta lista.
const presentaciones = await getPresentaciones();
const vista = verticales.map((v: any) => {
  const p = presentaciones[v.key];
  if (!p?.publicado || !p.hero) return v;
  return {
    ...v,
    landing: ruta(p.slug, 'es'),
    screenshot: imagen(p, p.hero.imagen),
    screenshotW: p.hero.ancho,
    screenshotH: p.hero.alto,
    features: bloque(p, 'es').funciones.slice(0, 4).map((x) => ({ icon: x.icono, name: x.titulo, desc: x.texto })),
  };
});
---
<BaseLayout title="Verticales · SuiteHub" description="15 verticales especializados de SuiteHub: HUB Taller, Carwash, POS, Restaurant, Market, Boutique, Pet, Salon, Clinic, Gym, Lavandería, Inmobiliaria, Hotel, Phone y Traffic.">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[400px] bg-radial-brand pointer-events-none"></div>
    <div class="wrap relative pt-12 pb-16">
      <div class="text-center max-w-3xl mx-auto">
        <span class="eyebrow">15 verticales especializados</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05]">
          SuiteHub <span class="text-gradient">adaptado a tu industria</span>.
        </h1>
        <p class="mt-6 text-lg text-ink-300 leading-relaxed">
          Cada vertical parte del núcleo de SuiteHub y le agregamos los procesos, los términos y las pantallas
          propias de tu negocio. No pagas por funciones pensadas para otro rubro.
        </p>
      </div>
    </div>
  </section>

  <!-- Index de verticales -->
  <section class="pb-12">
    <div class="wrap">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {vista.map(v => (
          <a href={v.landing ?? `#${v.key}`} class="group card-glass p-4 text-center hover:border-brand-500/30 transition-colors relative">
            {v.landing && (
              <span class="absolute top-2 right-2 text-[9px] uppercase tracking-wider font-bold text-emerald-400 bg-emerald-400/10 border border-emerald-400/30 rounded-full px-2 py-0.5">Ver más</span>
            )}
            <img src={`/images/products/${v.key}/badge.svg`} alt={v.name} class="w-10 h-10 mx-auto mb-2 group-hover:scale-110 transition-transform" loading="lazy" />
            <div class="text-xs font-display font-semibold">{v.name}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cada vertical en detalle -->
  {vista.map((v, i) => (
    <section id={v.key} class={`section ${i % 2 === 1 ? 'bg-navy-900/30' : ''}`}>
      <div class="wrap">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-14">
          <!-- Header -->
          <div class="lg:col-span-5 lg:sticky lg:top-28 self-start">
            <img src={`/images/products/${v.key}/badge.svg`} alt={v.name} class="h-20 w-20 mb-6" />
            <div class="text-xs uppercase tracking-wider text-brand-400 font-semibold mb-2">{v.sector}</div>
            <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">{v.name}</h2>
            <p class="text-base text-ink-300 leading-relaxed mb-6">{v.pitch}</p>

            {v.cliente && (
              <div class="card-glass p-4 mb-6">
                <div class="text-xs uppercase tracking-wider text-emerald-400 font-semibold mb-1">
                  <i class="fa-solid fa-circle-check"></i> En producción
                </div>
                <div class="text-sm text-ink-200">{v.cliente}</div>
              </div>
            )}

            <div class="flex flex-wrap gap-3">
              {v.landing && (
                <a href={v.landing} class="btn-primary">
                  <i class="fa-solid fa-arrow-right"></i>
                  Ver todo sobre {v.name}
                </a>
              )}
              <a href={`https://wa.me/50766326006?text=Hola%2C%20quiero%20info%20de%20${encodeURIComponent(v.name)}`}
                 target="_blank" rel="noopener" class={v.landing ? 'btn-secondary' : 'btn-primary'}>
                <i class="fa-brands fa-whatsapp"></i>
                Pregunta por {v.name}
              </a>
            </div>
          </div>

          <!-- Features grid -->
          <div class="lg:col-span-7">
            {v.screenshot && (
              <figure class="mb-8 rounded-xl overflow-hidden border border-white/10 shadow-glow-sm bg-navy-950">
                <img src={v.screenshot} alt={`Captura de pantalla de ${v.name}`} width={v.screenshotW ?? 1280} height={v.screenshotH} loading="lazy" decoding="async" class="w-full h-auto" />
              </figure>
            )}
            <h3 class="text-xs uppercase tracking-[0.2em] text-brand-400 font-semibold mb-5">Funciones propias de este vertical</h3>
            <div class="grid sm:grid-cols-2 gap-3">
              {(v.features ?? []).map(f => (
                <div class="card-glass p-5 hover:border-white/15 transition-colors">
                  <div class="flex items-start gap-3">
                    <div class="w-10 h-10 rounded-lg flex items-center justify-center text-brand-400 bg-white/5 flex-shrink-0">
                      <i class={`fa-solid ${f.icon}`}></i>
                    </div>
                    <div>
                      <div class="font-display font-semibold text-sm">{f.name}</div>
                      <div class="text-xs text-ink-400 mt-1 leading-relaxed">{f.desc}</div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <p class="mt-6 text-xs text-ink-500">
              + Las funciones del núcleo de SuiteHub que incluya la edición que elijas.
            </p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="card-glass gradient-border text-center p-10 lg:p-14 max-w-3xl mx-auto">
        <h2 class="text-3xl lg:text-4xl font-display font-bold mb-4">
          ¿Tu industria <span class="text-gradient">no está en la lista</span>?
        </h2>
        <p class="text-ink-300 mb-8 max-w-xl mx-auto">
          Si en alguno de nuestros mercados (Panamá, USA, Venezuela, España o Colombia) hay 50 o más negocios de tu rubro, podemos armar un vertical para ti.
          Escríbenos por WhatsApp y lo evaluamos.
        </p>
        <a href="https://wa.me/50766326006?text=Mi%20industria%20es%20...%20%C2%BFpueden%20crear%20un%20vertical%3F" target="_blank" rel="noopener" class="btn-primary">
          <i class="fa-brands fa-whatsapp"></i> Cuéntanos tu industria
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
