---
import BaseLayout from '../layouts/BaseLayout.astro';
import instalaciones from '../data/instalaciones.json';

const verticales = [
  { key: 'taller',     name: 'HUB Taller',     desc: 'Talleres mecánicos',         icon: 'fa-screwdriver-wrench' },
  { key: 'carwash',    name: 'HUB Carwash',    desc: 'Autolavados y car wash',     icon: 'fa-spray-can-sparkles' },
  { key: 'pos',        name: 'HUB POS',        desc: 'Restaurantes, bares y food trucks', icon: 'fa-cash-register' },
  { key: 'restaurant', name: 'HUB Restaurant', desc: 'Restaurantes con salón y mesas', icon: 'fa-utensils' },
  { key: 'market',     name: 'HUB Market',     desc: 'Minimarkets y supermercados', icon: 'fa-cart-shopping' },
  { key: 'boutique',   name: 'HUB Boutique',   desc: 'Boutiques de ropa y retail',  icon: 'fa-shirt' },
  { key: 'pet',        name: 'HUB Pet',        desc: 'Veterinarias y pet shops',   icon: 'fa-paw' },
  { key: 'lavanderia', name: 'HUB Lavandería', desc: 'Lavanderías profesionales',  icon: 'fa-soap' },
  { key: 'salon',      name: 'HUB Salon',      desc: 'Salones de belleza, barberías', icon: 'fa-scissors' },
  { key: 'clinic',     name: 'HUB Clinic',     desc: 'Consultorios y clínicas',    icon: 'fa-stethoscope' },
  { key: 'gym',        name: 'HUB Gym',        desc: 'Gimnasios y boxes de CrossFit', icon: 'fa-dumbbell' },
  { key: 'inmobiliaria', name: 'HUB Inmobiliaria', desc: 'Bienes raíces',          icon: 'fa-building' },
  { key: 'hotel',      name: 'HUB Hotel',      desc: 'Hoteles boutique',           icon: 'fa-hotel' },
  { key: 'phone',      name: 'HUB Phone',      desc: 'Reparación de celulares',    icon: 'fa-mobile-screen' },
  { key: 'traffic',    name: 'HUB Traffic',    desc: 'Conteo de visitas y mapas de calor en tienda', icon: 'fa-people-arrows' },
];

const pacs = [
  {
    name: 'Digifact',
    desc: 'PAC certificado DGI con API moderna',
    icon: 'fa-bolt',
    color: 'text-brand-400',
  },
  {
    name: 'The Factory HKA',
    desc: 'Líder regional en facturación electrónica',
    icon: 'fa-industry',
    color: 'text-sky-400',
  },
  {
    name: 'Ebi PAC',
    desc: 'Emisión SOAP con CUFE, QR y protocolo DGI',
    icon: 'fa-network-wired',
    color: 'text-violet-400',
  },
  {
    name: 'Factura Fácil',
    desc: 'PAC panameño, sencillo de usar',
    icon: 'fa-receipt',
    color: 'text-emerald-400',
  },
  {
    name: 'eFacturapty',
    desc: 'PAC panameño certificado por la DGI',
    icon: 'fa-file-invoice',
    color: 'text-amber-400',
  },
  {
    name: 'The Factory HKA Venezuela',
    desc: 'Imprenta Digital del SENIAT en Venezuela',
    icon: 'fa-globe-americas',
    color: 'text-fuchsia-400',
  },
];

const testimonios = [
  {
    quote: 'Cambiamos de un sistema viejo a Hub Pro y en una semana ya facturábamos electrónicamente sin un solo rechazo de DGI. La diferencia es brutal.',
    author: 'Raúl Romero',
    role:   'Técnico Principal · QS Express',
    initial: 'R',
    logo:    '/images/tallerqsexpress.png',
  },
];

const clientes = [
  { name: 'QS Express',          sector: 'Taller mecánico',           logo: '/images/tallerqsexpress.png' },
  { name: 'Clean Factory',       sector: 'Limpieza de zapatos',       logo: '/images/cleanfactory.webp' },
  { name: 'KM Seguridad',        sector: 'Seguridad',                 logo: '/images/kmslogo.webp' },
  { name: 'CVE Panamá',          sector: 'Distribución tecnológica',  logo: '/images/cvepanama_web.webp' },
  { name: 'Inversiones Fortune', sector: 'Consultoría internacional', logo: '/images/fortune.webp' },
  // Los de abajo salen solos de instalaciones.json, el mismo archivo que alimenta /casos.
  ...instalaciones.filter((s) => s.logo).map((s) => ({ name: s.nombre, sector: s.sector.es, logo: s.logo })),
];

const stats = [
  { num: '+50',  label: 'Pymes activas (Panamá)' },
  { num: '5',    label: 'Países objetivo (PA · US · VE · ES · CO)' },
  { num: '15',   label: 'Verticales especializados' },
  { num: '<24h', label: 'Respuesta de soporte' },
];

---
<BaseLayout
  title="SuiteHub: gestión y facturación electrónica para pymes"
  description="Software de gestión para pymes, de PROOQ LLC (USA). Facturación electrónica activa con la DGI de Panamá y el SENIAT de Venezuela, y en planes para 2026 Facturae España, DIAN Colombia y la normativa fiscal de USA. Multi-sucursal, automatizaciones y API. En español e inglés, desde $24/mes.">

  <!-- ════════════════════════════════════════════════════════════
       HERO
       ════════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid pointer-events-none" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-[600px] bg-radial-brand pointer-events-none" aria-hidden="true"></div>

    <div class="wrap relative section">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="animate-fade-up">
          <span class="eyebrow">
            <i class="fa-solid fa-bolt mr-1"></i> Software para pymes · PA · US · VE · ES · CO
          </span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-bold leading-[1.05] tracking-tight">
            El sistema<br/>
            <span class="text-gradient">que crece</span><br/>
            con tu negocio.
          </h1>
          <p class="mt-6 text-lg text-ink-300 max-w-xl leading-relaxed">
            Software de gestión para pymes en <strong class="text-white">Panamá, USA, Venezuela, España y Colombia</strong>.
            Factura electrónica según tu país, varias sucursales, tareas automáticas y API REST.
            <span class="text-brand-300">Desde $24/mes.</span>
          </p>

          <!-- Idiomas badge -->
          <div class="mt-5 inline-flex items-center gap-2 text-xs px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-300">
            <i class="fa-solid fa-globe"></i>
            Disponible en <strong class="text-white">español</strong> e <strong class="text-white">inglés</strong>
          </div>

          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href="https://wa.me/50766326006?text=Hola%2C%20quiero%20una%20demo"
               target="_blank" rel="noopener" class="btn-primary text-base">
              <i class="fa-brands fa-whatsapp text-xl"></i>
              Habla con un asesor
            </a>
            <a href="/precios" class="btn-secondary text-base">
              Ver ediciones y precios
              <i class="fa-solid fa-arrow-right text-xs ml-1"></i>
            </a>
          </div>

          <div class="mt-10 flex flex-wrap items-center gap-6 text-sm text-ink-400">
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-shield-halved text-emerald-400"></i>
              Facturación electrónica
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-clock text-brand-400"></i>
              Listo en 24 horas
            </div>
            <div class="flex items-center gap-2">
              <i class="fa-solid fa-headset text-brand-400"></i>
              Soporte ES / EN
            </div>
          </div>
        </div>

        <!-- Visual: ilustración de la oficina de SuiteHub -->
        <div class="relative animate-fade-in" style="perspective:1200px;">
          <!-- Glow orb -->
          <div class="absolute -inset-10 bg-brand-600/20 rounded-full blur-3xl" aria-hidden="true"></div>

          <div id="hero-tilt" class="tilt relative browser-mock">
            <img src="/images/suitehub-hero.webp" alt="Ilustración de la oficina de SuiteHub con el equipo trabajando"
                 width="1200" height="896" fetchpriority="high"
                 class="w-full block" />
          </div>

          <!-- Pill flotante: facturación electrónica -->
          <div class="absolute -top-4 -right-2 sm:-right-5 card-glass px-3.5 py-2 flex items-center gap-2 shadow-2xl">
            <i class="fa-solid fa-receipt text-emerald-400"></i>
            <span class="text-xs font-medium">Factura electrónica con CUFE</span>
          </div>

          <!-- Pill flotante: live -->
          <div class="absolute -bottom-5 left-3 sm:-left-5 card-glass px-4 py-2.5 flex items-center gap-3 shadow-2xl">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span class="text-xs font-medium">+50 negocios facturando hoy</span>
          </div>
        </div>
      </div>

      <!-- Stats strip -->
      <div class="reveal mt-20 lg:mt-28 grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/5 rounded-2xl overflow-hidden border border-white/5">
        {stats.map((s, i) => (
          <div class={`reveal reveal-delay-${i + 1} bg-navy-950 p-6 lg:p-8 text-center`}>
            <div class="text-3xl lg:text-4xl font-display font-bold text-white tabular-nums" data-countup={s.num}>{s.num}</div>
            <div class="text-xs uppercase tracking-wider text-ink-400 mt-2">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       UNA PLATAFORMA, MUCHOS NEGOCIOS
       ════════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="wrap">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="eyebrow">Una sola plataforma</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold">
          Tu negocio y el de al lado, <span class="text-gradient">en el mismo sistema.</span>
        </h2>
        <p class="mt-5 text-ink-300 leading-relaxed">
          Un restaurante, un taller, un salón, una tienda, una clínica y un hotel trabajan distinto,
          y cada uno usa su propia versión de SuiteHub. Por dentro es el mismo motor: ventas,
          inventario, facturación electrónica y reportes en un solo lugar.
        </p>
      </div>

      <figure class="reveal max-w-5xl mx-auto">
        <img src="/images/suitehub-ecosistema.webp"
             alt="Ilustración de una manzana de negocios (restaurante, tienda, taller, salón, clínica, gimnasio y hotel) conectados al sistema SuiteHub"
             width="1200" height="670" loading="lazy" decoding="async"
             class="w-full block rounded-2xl border border-white/10 shadow-2xl" />
      </figure>

      <p class="text-center mt-8 text-sm text-ink-400">
        Hay una versión para cada oficio.
        <a href="/verticales" class="text-brand-400 hover:text-brand-300 font-medium">Mira los verticales</a>.
      </p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       PACs INTEGRADOS
       ════════════════════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 bg-navy-900/30 border-y border-white/5">
    <div class="wrap">
      <div class="text-center mb-10">
        <span class="eyebrow">Facturación electrónica por país</span>
        <h2 class="text-2xl sm:text-3xl font-display font-bold">
          Ya trabajamos con <span class="text-gradient">6 PACs</span>, 5 con la DGI de Panamá y 1 con el SENIAT de Venezuela · Próximamente: Facturae ES, DIAN CO y normativa fiscal US
        </h2>
        <p class="mt-3 text-sm text-ink-400 max-w-xl mx-auto">
          Tú eliges el PAC. SuiteHub se conecta directo y se encarga de todo el proceso (XML, CUFE y QR en Panamá; JSON y Número de Control en Venezuela), así que no tienes que estar pendiente de la normativa. Además, está hecho para sumar otros países sin cambiar tu forma de trabajar.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 max-w-5xl mx-auto">
        {pacs.map((p, i) => (
          <div class={`reveal reveal-delay-${i + 1} lift card-glass p-6 text-center hover:border-brand-500/30 transition-colors`}>
            <div class={`w-12 h-12 mx-auto rounded-xl bg-white/5 flex items-center justify-center text-2xl mb-3 ${p.color}`}>
              <i class={`fa-solid ${p.icon}`}></i>
            </div>
            <div class="font-display font-semibold text-base">{p.name}</div>
            <p class="text-xs text-ink-400 mt-1.5">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       VERTICALES
       ════════════════════════════════════════════════════════════ -->
  <section id="verticales" class="section bg-navy-900/50 relative overflow-hidden">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-brand-600/10 rounded-full blur-3xl"></div>

    <div class="wrap relative">
      <div class="text-center mb-16 max-w-2xl mx-auto">
        <span class="eyebrow">Verticales especializados</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold">
          Una versión <span class="text-gradient">para cada negocio.</span>
        </h2>
        <p class="mt-5 text-ink-300 leading-relaxed">
          Un taller no trabaja igual que un restaurante o una clínica.
          Cada vertical es SuiteHub ajustado a un tipo de negocio, con sus propios términos y pasos, y lo puedes usar desde el primer día.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {verticales.map((v, i) => (
          <a href={`/verticales#${v.key}`}
             class={`reveal reveal-delay-${(i % 4) + 1} group lift card-glass p-5 hover:border-brand-500/30 hover:bg-white/[0.05] transition-all`}>
            <img src={`/images/products/${v.key}/badge.svg`} alt={v.name} class="w-12 h-12 mb-4 group-hover:scale-110 transition-transform" loading="lazy" />
            <h3 class="text-base font-display font-semibold mb-1">{v.name}</h3>
            <p class="text-xs text-ink-400">{v.desc}</p>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/verticales" class="inline-flex items-center gap-2 text-brand-400 hover:text-brand-300 text-sm font-medium">
          Conoce todos los verticales <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       CLIENTES
       ════════════════════════════════════════════════════════════ -->
  <section class="section bg-navy-900/30">
    <div class="wrap">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="eyebrow">Quiénes ya lo usan</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold">
          Negocios que <span class="text-gradient">ya trabajan con SuiteHub.</span>
        </h2>
        <p class="mt-5 text-ink-300 leading-relaxed">
          Restaurantes, bares, talleres, tiendas y empresas de servicio.
          Oficios que no se parecen en nada, y por dentro el mismo sistema.
        </p>
      </div>

      <ul class="flex flex-wrap justify-center gap-5 sm:gap-6 max-w-5xl mx-auto">
        {clientes.map((c, i) => (
          <li class={`reveal reveal-delay-${(i % 4) + 1} text-center`}>
            <div class="w-32 h-20 sm:w-36 sm:h-24 rounded-2xl bg-white p-3.5 flex items-center justify-center">
              <img src={c.logo} alt={c.name} width="144" height="96" loading="lazy" class="max-h-full max-w-full object-contain" />
            </div>
            <div class="mt-2.5 text-xs font-medium text-ink-200">{c.name}</div>
            <div class="text-[11px] text-ink-500">{c.sector}</div>
          </li>
        ))}
      </ul>

      <div class="max-w-2xl mx-auto mt-14">
        {testimonios.map((t, i) => (
          <figure class={`reveal reveal-delay-${i + 1} card-glass p-7 flex flex-col`}>
            <div class="text-brand-400 text-2xl mb-4">
              <i class="fa-solid fa-quote-left"></i>
            </div>
            <blockquote class="text-ink-200 leading-relaxed flex-1 italic">
              "{t.quote}"
            </blockquote>
            <figcaption class="mt-6 pt-6 border-t border-white/5 flex items-center gap-3">
              {t.logo ? (
                <img src={t.logo} alt={t.author} class="w-10 h-10 rounded-full bg-white/10 object-contain p-1" />
              ) : (
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white font-bold text-sm">
                  {t.initial}
                </div>
              )}
              <div>
                <div class="text-sm font-medium text-white">{t.author}</div>
                <div class="text-xs text-ink-400">{t.role}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/casos" class="inline-flex items-center gap-2 text-brand-400 hover:text-brand-300 text-sm font-medium">
          Lee los casos completos <i class="fa-solid fa-arrow-right text-xs"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       CTA FINAL
       ════════════════════════════════════════════════════════════ -->
  <section class="section relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-brand pointer-events-none"></div>

    <div class="wrap relative">
      <div class="card-glass gradient-border text-center p-12 lg:p-16 max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-display font-bold mb-5">
          Te ayudamos a <span class="text-gradient">empezar hoy.</span>
        </h2>
        <p class="text-ink-300 max-w-xl mx-auto leading-relaxed mb-10">
          Conversemos por WhatsApp y te muestro SuiteHub en vivo en menos de 15 minutos.
          No tienes que llenar formularios ni comprometerte a nada.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="https://wa.me/50766326006?text=Hola%2C%20quiero%20agendar%20una%20demo"
             target="_blank" rel="noopener"
             class="btn-primary text-base px-8">
            <i class="fa-brands fa-whatsapp text-xl"></i>
            Hablar por WhatsApp
          </a>
          <a href="mailto:info@suitehub.net?subject=Quiero%20conocer%20SuiteHub"
             class="btn-secondary text-base px-8">
            <i class="fa-solid fa-envelope"></i>
            Escribir por correo
          </a>
        </div>
        <p class="mt-8 text-xs text-ink-500">
          O llámanos al <a href="tel:+50766326006" class="text-ink-300 hover:text-white">+507 6632-6006</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       Micro-interacciones: count-up · tilt del héroe
       ════════════════════════════════════════════════════════════ -->
  <script is:inline>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* Count-up en stats */
      const counters = document.querySelectorAll('[data-countup]');
      if (counters.length && !reduce && 'IntersectionObserver' in window) {
        counters.forEach((el) => {
          const m = (el.dataset.countup || '').match(/^(\D*)(\d+)(.*)$/);
          if (m) el.textContent = m[1] + '0' + m[3];
        });
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            obs.unobserve(e.target);
            const el = e.target;
            const raw = el.dataset.countup;
            const m = raw.match(/^(\D*)(\d+)(.*)$/);
            if (!m) { el.textContent = raw; return; }
            const pre = m[1], target = parseInt(m[2], 10), suf = m[3];
            const dur = 1100, t0 = performance.now();
            (function tick(now) {
              const p = Math.min((now - t0) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = pre + Math.round(target * eased) + suf;
              if (p < 1) requestAnimationFrame(tick); else el.textContent = raw;
            })(t0);
          });
        }, { threshold: 0.4 });
        counters.forEach((el) => obs.observe(el));
      }

      /* Tilt 3D del héroe (solo puntero fino, sin reduced-motion) */
      const tilt = document.getElementById('hero-tilt');
      if (tilt && !reduce && window.matchMedia('(pointer: fine)').matches) {
        const max = 6;
        tilt.addEventListener('mousemove', (ev) => {
          const r = tilt.getBoundingClientRect();
          const px = (ev.clientX - r.left) / r.width - 0.5;
          const py = (ev.clientY - r.top) / r.height - 0.5;
          tilt.style.transform = 'rotateY(' + (px * max) + 'deg) rotateX(' + (-py * max) + 'deg)';
        });
        tilt.addEventListener('mouseleave', () => { tilt.style.transform = ''; });
      }
    })();
  </script>

</BaseLayout>
