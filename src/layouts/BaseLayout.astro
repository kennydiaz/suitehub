---
import { MOSTRAR_RAZON_SOCIAL, rs } from '../config/razon-social';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLocaleFromUrl, useTranslations, alternateHref } from '../i18n/utils';
import { getEdiciones, precioEdicion } from '../lib/catalog';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const isEn = locale === 'en';

// Precios de ediciones desde el catálogo canónico del panel (con respaldo local).
const _ed = await getEdiciones();
// Sin respaldo escrito a mano: ver precioEdicion() en lib/catalog.ts.
const _precio = Object.fromEntries(await Promise.all(
  ['lite', 'core', 'pro', 'enterprise'].map(async (k) => [k, await precioEdicion(k)]),
));

const defaultTitle = isEn
  ? 'SuiteHub: business management software for SMBs in several countries'
  : 'SuiteHub: sistema de gestión para PYMEs en varios países';

const defaultDesc = isEn
  ? `Business management software for SMBs.${rs(' Made by PROOQ LLC (USA).')} E-invoicing already live with DGI Panama and SENIAT Venezuela, with Facturae Spain, DIAN Colombia and US state-level compliance planned for 2026. Multiple branches, automations and an API. From $24/month, in Spanish and English.`
  : `Sistema de gestión para PYMEs.${rs(' Hecho por PROOQ LLC (USA).')} Facturación electrónica ya funcionando con la DGI de Panamá y el SENIAT de Venezuela, y en camino para 2026 Facturae (España), DIAN (Colombia) y cumplimiento en USA. Varias sucursales, automatizaciones y API. Desde $24/mes, en español e inglés.`;

const {
  title       = defaultTitle,
  description = defaultDesc,
  ogImage     = '/images/products/suite/light-1200.png',
  ogType      = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const altPath   = alternateHref(Astro.url.pathname, isEn ? 'es' : 'en');
const altUrl    = new URL(altPath, Astro.site).toString();
const esUrl     = isEn ? altUrl : canonical;
const enUrl     = isEn ? canonical : altUrl;

const htmlLang  = isEn ? 'en' : 'es';
const ogLocale  = isEn ? 'en_US' : 'es_PA';
const altOgLoc  = isEn ? 'es_PA' : 'en_US';
---
<!DOCTYPE html>
<html lang={htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang alternates -->
    <link rel="alternate" hreflang="es"      href={esUrl} />
    <link rel="alternate" hreflang="en"      href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicons/favicon-hex.svg" />
    <link rel="icon" type="image/png" sizes="32x32"  href="/favicons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicons/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/favicons/favicon-192.png" />

    <!-- Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonical} />
    <meta property="og:image"       content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name"   content="SuiteHub" />
    <meta property="og:locale"      content={ogLocale} />
    <meta property="og:locale:alternate" content={altOgLoc} />

    <!-- Twitter -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={new URL(ogImage, Astro.site).toString()} />

    <!-- Theme color -->
    <meta name="theme-color" content="#0A2540" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <!-- JSON-LD: SoftwareApplication + Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "SuiteHub",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "url": "https://suitehub.net",
      "description": description,
      "offers": [
        { "@type": "Offer", "name": "Hub Lite",       "price": String(_precio.lite),       "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Hub Core",       "price": String(_precio.core),       "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Hub Pro",        "price": String(_precio.pro),        "priceCurrency": "USD" },
        { "@type": "Offer", "name": "Hub Enterprise", "price": String(_precio.enterprise),"priceCurrency": "USD" }
      ],
      "inLanguage": ["es", "en"],
      "publisher": {
        "@type": "Organization",
        "name": "SuiteHub",
        ...(MOSTRAR_RAZON_SOCIAL ? { "legalName": "PROOQ LLC" } : {}),
        "url": "https://suitehub.net",
        "logo": "https://suitehub.net/images/products/suite/light-600.png",
        "address": [
          {
            "@type": "PostalAddress",
            "streetAddress": "Elmwood Park",
            "addressLocality": "Chicago",
            "addressRegion": "IL",
            "postalCode": "60707-2003",
            "addressCountry": "US"
          },
          {
            "@type": "PostalAddress",
            "streetAddress": "Vía Argentina, Bella Vista",
            "addressLocality": isEn ? "Panama City" : "Ciudad de Panamá",
            "addressCountry": "PA"
          },
          {
            "@type": "PostalAddress",
            "streetAddress": "Calle La Línea 15",
            "addressLocality": "Puerto Real",
            "addressRegion": "Andalucía",
            "postalCode": "11510",
            "addressCountry": "ES"
          }
        ],
        "areaServed": ["PA", "US", "VE", "ES", "CO"],
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": "+1-708-540-0888",
            "contactType": "sales",
            "email": "info@suitehub.net",
            "areaServed": "US",
            "availableLanguage": ["es", "en"]
          },
          {
            "@type": "ContactPoint",
            "telephone": "+507-6632-6006",
            "contactType": "sales",
            "email": "info@suitehub.net",
            "areaServed": "PA",
            "availableLanguage": ["es", "en"]
          },
          {
            "@type": "ContactPoint",
            "telephone": "+34-641-246302",
            "contactType": "sales",
            "email": "info@suitehub.net",
            "areaServed": "ES",
            "availableLanguage": ["es", "en"]
          },
          {
            "@type": "ContactPoint",
            "contactType": "sales",
            "email": "info@suitehub.net",
            "areaServed": "VE",
            "availableLanguage": ["es", "en"]
          },
          {
            "@type": "ContactPoint",
            "contactType": "sales",
            "email": "info@suitehub.net",
            "areaServed": "CO",
            "availableLanguage": ["es", "en"]
          }
        ]
      }
    })} />

    <!-- JSON-LD: LocalBusiness (operación Panamá — SEO local / Google Maps) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "SuiteHub Panamá",
      "image": "https://suitehub.net/images/products/suite/light-600.png",
      "url": "https://suitehub.net",
      "telephone": "+507-6632-6006",
      "email": "info@suitehub.net",
      "priceRange": "$24–$196/mes",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Vía Argentina, Bella Vista",
        "addressLocality": isEn ? "Panama City" : "Ciudad de Panamá",
        "addressCountry": "PA"
      },
      "areaServed": ["PA", "US", "VE", "ES", "CO"],
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "08:00",
        "closes": "18:00"
      }],
      "sameAs": ["https://panel.suitehub.net"]
    })} />

    <!-- JSON-LD adicional por página (Article, FAQPage, BreadcrumbList…) -->
    <slot name="head" />
  </head>
  <body>
    <!-- Iconos SVG definidos una vez y usados con <use href="#…">. Hoy solo WhatsApp:
         era el único icono de marca, y como fuente obligaba a bajar 107 KB por página. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="i-whatsapp" viewBox="0 0 448 512">
        <!--! Font Awesome Free 6.4.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) Copyright 2023 Fonticons, Inc. -->
        <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
      </symbol>
    </svg>
    <Header />
    <main class="pt-20">
      <slot />
    </main>
    <Footer />

    <!-- WhatsApp floating -->
    <a href={`https://wa.me/50766326006?text=${t('wa.text.more')}`}
       target="_blank" rel="noopener"
       aria-label={t('wa.float.aria')}
       class="fixed bottom-6 right-6 z-40 w-14 h-14 rounded-full bg-emerald-500 hover:bg-emerald-400 text-white text-2xl flex items-center justify-center shadow-2xl shadow-emerald-500/30 transition-transform hover:scale-110">
      <svg class="ico" aria-hidden="true"><use href="#i-whatsapp"></use></svg>
    </a>

    <!-- Scroll-reveal: añade .is-visible cuando el elemento entra al viewport -->
    <script is:inline>
      (function () {
        if (typeof IntersectionObserver === 'undefined') return;
        const obs = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              obs.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
        document.querySelectorAll('.reveal').forEach((el) => obs.observe(el));
      })();
    </script>

    <!-- ════════════════════════════════════════════════════════════
         Analytics — descomentar uno cuando contrates servicio
         ════════════════════════════════════════════════════════════ -->

    <!-- OPCIÓN 1: Plausible (privacy-first, $9/mes) -->
    <!-- <script defer data-domain="suitehub.net" src="https://plausible.io/js/script.js"></script> -->

    <!-- OPCIÓN 2: Google Analytics 4 (gratis) — ACTIVO -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HRWL3FG6SF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HRWL3FG6SF');
    </script>

    <!-- Medición propia SuiteHub → panel.suitehub.net (first-party, no depende de Google) -->
    <script is:inline>
      (function(){
        try {
          if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;
          var i = new Image();
          i.src = 'https://panel.suitehub.net/track.php?p=' + encodeURIComponent(location.pathname)
                + '&r=' + encodeURIComponent(document.referrer) + '&t=' + Date.now();
        } catch (e) {}
      })();
    </script>
  </body>
</html>
